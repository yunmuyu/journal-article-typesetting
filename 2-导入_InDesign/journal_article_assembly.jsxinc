    }
    function panelRows(heights,columns,gap){if(!(columns>0)||columns!==Math.floor(columns))fail('PANEL_COLUMNS',columns);var rows=[],offsets=[],i,row,total=0;for(i=0;i<heights.length;i++){row=Math.floor(i/columns);rows[row]=Math.max(rows[row]||0,heights[i]);}for(row=0;row<rows.length;row++){for(i=row*columns;i<Math.min(heights.length,(row+1)*columns);i++)offsets[i]=total;total+=rows[row]+(row+1<rows.length?gap:0);}return {offsets:offsets,height:total};}
    function refreshPanels(d,body,job,fillPreceding){
        var prepared=prepareBlocks(parse(job.logicalArticlePath),job.panels),out=[],g=job.templateContract.geometry;
        for(var index=0;index<job.panels.length;index++){
            var spec=job.panels[index];
            if(spec.pageTop===true){
                if(spec.afterParagraphText){
                    var boundary=[];
                    for(var bpi=0;bpi<body.paragraphs.length;bpi++)if(plain(body.paragraphs[bpi].contents)===plain(spec.afterParagraphText))boundary.push(bpi);
                    if(boundary.length!==1)fail("PANEL_TOP_BOUNDARY",index);
                    var following=boundary[0]+1;while(following<body.paragraphs.length&&!plain(body.paragraphs[following].contents)){body.paragraphs[following].startParagraph=StartParagraph.ANYWHERE;following++;}
                    body.paragraphs[following].startParagraph=spec.keepFollowingAfterPanel===true?StartParagraph.NEXT_PAGE:StartParagraph.ANYWHERE;
                }
                var topParts=[],topPage=null,topHeight=0,topBounds=[],topHeights=[];
                for(var tn=0;tn<spec.numbers.length;tn++){
                    var tf=labeled(d,"figure-band-caption-"+spec.numbers[tn]),tb=tf.geometricBounds;
                    topParts.push(tf);topPage=tf.parentPage;topBounds.push(tb);topHeights.push(tb[2]-tb[0]);
                }
