            if(plain(marker.contents)||Number(marker.leading)>.11)fail("PANEL_REFRESH_MARKER",index);
            while(afterIndex<body.paragraphs.length&&!plain(body.paragraphs[afterIndex].contents))afterIndex++;
            var after=body.paragraphs[afterIndex],parts=[],page=null,oldTop=1e9,oldBottom=-1e9;
            for(var ni=0;ni<spec.numbers.length;ni++){
                var part=labeled(d,"figure-band-caption-"+spec.numbers[ni]);parts.push({item:part,bounds:part.geometricBounds});
                if(page&&page.id!==part.parentPage.id)fail("PANEL_REFRESH_PAGES",index);page=part.parentPage;
                oldTop=Math.min(oldTop,part.geometricBounds[0]);oldBottom=Math.max(oldBottom,part.geometricBounds[2]);
