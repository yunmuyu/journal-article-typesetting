            pair[1].nextTextFrame=lowerLeft;lowerLeft.nextTextFrame=lowerRight;if(nextId!==null)lowerRight.nextTextFrame=item(d,nextId);
            after.startParagraph=StartParagraph.NEXT_COLUMN;
            function trial(cut) {
                for(var j=0;j<2;j++){var b=pair[j].geometricBounds;b[2]=cut;pair[j].geometricBounds=b;}
                var b=lowerLeft.geometricBounds;b[0]=cut+parts.height+8;lowerLeft.geometricBounds=b;
                b=lowerRight.geometricBounds;b[0]=cut+parts.height+8;lowerRight.geometricBounds=b;
                d.recompose();var f=marker.insertionPoints[0].parentTextFrames;
