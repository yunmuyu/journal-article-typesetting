                for(var back=bi-1;back>=0;back--)if(plain(prepared.blocks[back].text)&&prepared.blocks[back].panelIndex===undefined){anchorText=plain(prepared.blocks[back].text);break;}
            }
            var matches=[];
            for(var pi=0;pi<body.paragraphs.length;pi++)if(plain(body.paragraphs[pi].contents)===anchorText)matches.push(pi);
