    }
    function reflowExisting(appInstance,job){
        var state=JournalDocumentSession.acquire(appInstance,job.outputPath),d=state.document;
        if(d.id!==job.continuation.documentId)fail("DOCUMENT_ID_CHANGED");
        var oldUI=appInstance.scriptPreferences.userInteractionLevel,oldRedraw=appInstance.scriptPreferences.enableRedraw;
        try{
            appInstance.scriptPreferences.userInteractionLevel=UserInteractionLevels.NEVER_INTERACT;appInstance.scriptPreferences.enableRedraw=false;
            var result=JournalReflow.apply(d,parse(job.reflowPlanPath),function(doc,body){return refreshPanels(doc,body,job);});
            result.status="reflowed-unchecked";result.documentId=d.id;result.outputPath=job.outputPath;
            d.insertLabel("journal-assembly-stage","reflowed-current-candidate");JournalDocumentSession.save(d,state);return result;
        }finally{appInstance.scriptPreferences.userInteractionLevel=oldUI;appInstance.scriptPreferences.enableRedraw=oldRedraw;}
    }
    function applyBottomExisting(appInstance,job){
        var state=JournalDocumentSession.acquire(appInstance,job.outputPath),d=state.document;
        if(d.id!==job.continuation.documentId)fail("DOCUMENT_ID_CHANGED");
        var oldUI=appInstance.scriptPreferences.userInteractionLevel,oldRedraw=appInstance.scriptPreferences.enableRedraw;
        try{
            appInstance.scriptPreferences.userInteractionLevel=UserInteractionLevels.NEVER_INTERACT;appInstance.scriptPreferences.enableRedraw=false;
            var result=JournalBottomPlan.apply(d,parse(job.bottomPlanPath));JournalLayout.alignLocalBlocks(d,parse(job.auditConfigPath));
            result.status="bottom-applied-unchecked";result.documentId=d.id;result.outputPath=job.outputPath;
            d.insertLabel("journal-assembly-stage","bottom-plan-applied");JournalDocumentSession.save(d,state);return result;
        }finally{appInstance.scriptPreferences.userInteractionLevel=oldUI;appInstance.scriptPreferences.enableRedraw=oldRedraw;}
    }
    function layoutExisting(appInstance,job){
        var state=JournalDocumentSession.acquire(appInstance,job.outputPath),d=state.document;
        if(d.id!==job.continuation.documentId)fail("DOCUMENT_ID_CHANGED");
        var oldUI=appInstance.scriptPreferences.userInteractionLevel,oldRedraw=appInstance.scriptPreferences.enableRedraw,oldPreflight=d.preflightOptions.preflightOff;
        try{
            appInstance.scriptPreferences.userInteractionLevel=UserInteractionLevels.NEVER_INTERACT;appInstance.scriptPreferences.enableRedraw=false;d.preflightOptions.preflightOff=true;
            if(job.continuedTableTemplatePath){
                var lastPageId=d.pages[-1].id,bodyFrames=slot(d,"body-left").parentStory.textContainers;
                for(var cfi=0;cfi<bodyFrames.length;cfi++)if(bodyFrames[cfi].parentPage.id===lastPageId){var cfb=bodyFrames[cfi].geometricBounds;cfb[2]=job.templateContract.geometry.bodyBottomMm;bodyFrames[cfi].geometricBounds=cfb;}
                JournalLayout.syncContinuedTables(d,JournalDocumentSession.acquire(appInstance,job.continuedTableTemplatePath).document);
            }
            var result=JournalLayoutProfile.apply(d,slot(d,"body-left").parentStory,job.layoutProfile,function(doc,body){return refreshPanels(doc,body,job);});
            JournalLayout.formulaLineSpacing(d,true);result.panels=refreshPanels(d,slot(d,"body-left").parentStory,job);
            if(job.continuedTableTemplatePath){
                result.continuations=JournalLayout.syncContinuedTables(d,JournalDocumentSession.acquire(appInstance,job.continuedTableTemplatePath).document);
                result.panels=refreshPanels(d,slot(d,"body-left").parentStory,job);
                if(slot(d,"body-left").parentStory.overflows)fail("CONTINUATION_STORY_OVERFLOW");
            }
            result.status="layout-applied-unchecked";result.documentId=d.id;result.outputPath=job.outputPath;
            d.insertLabel("journal-assembly-stage","shared-layout-profile-applied");d.preflightOptions.preflightOff=oldPreflight;
            JournalDocumentSession.save(d,state);return result;
        }finally{appInstance.scriptPreferences.userInteractionLevel=oldUI;appInstance.scriptPreferences.enableRedraw=oldRedraw;d.preflightOptions.preflightOff=oldPreflight;}
    }
    function run(appInstance,job) {
        if(job.paragraphAdjustments&&job.paragraphAdjustments.length)fail("AUTHOR_REPAIR_FORBIDDEN");
        var data=parse(job.logicalArticlePath),supp=parse(job.supplementPath),structures=parse(job.tableStructurePath),prepared=prepareBlocks(data,job.panels);
        validateFormulaMarkers(prepared.blocks);
        var state=JournalDocumentSession.acquire(appInstance,job.outputPath),d=state.document;
        if(!state.openedHere)fail("ASSEMBLY_TARGET_ALREADY_OPEN");
        var oldRedraw=appInstance.scriptPreferences.enableRedraw,oldUI=appInstance.scriptPreferences.userInteractionLevel,oldPreflight=d.preflightOptions.preflightOff;
        var bindings=[],result={status:"running",documentId:d.id,outputPath:job.outputPath,bindings:bindings,phases:[],panels:[]},started=new Date().getTime();
        function phase(name){result.phases.push({name:name,elapsedMs:new Date().getTime()-started});d.insertLabel("journal-assembly-stage",name);}
        try{
            appInstance.scriptPreferences.enableRedraw=false;appInstance.scriptPreferences.userInteractionLevel=UserInteractionLevels.NEVER_INTERACT;d.preflightOptions.preflightOff=true;
            if(d.extractLabel("journal-template-contract")!==job.templateContractVersion)fail("TEMPLATE_CONTRACT");
            d.viewPreferences.rulerOrigin=RulerOrigin.PAGE_ORIGIN;d.zeroPoint=[0,0];d.viewPreferences.horizontalMeasurementUnits=MeasurementUnits.MILLIMETERS;d.viewPreferences.verticalMeasurementUnits=MeasurementUnits.MILLIMETERS;
            var front=slot(d,"front-title"),footer=slot(d,"received-fund"),doi=slot(d,"doi"),firstLeft=slot(d,"body-left"),firstRight=slot(d,"body-right"),body=firstLeft.parentStory;
            if(firstRight.parentStory.id!==body.id)fail("BODY_SLOT_STORY");
            // In issue-continuation mode the article pages are already seeded; do not
            // grow the whole document to expected.pages or reset the issue's first section.
            if(job.articlePageOrigin===undefined||job.articlePageOrigin===null){
                while(d.pages.length<job.expected.pages)addPage(d,body,job.templateContract.geometry);
                d.sections[0].continueNumbering=false;d.sections[0].pageNumberStart=job.pageNumberStart;
            } else {
                var articleStartPage=d.pages[job.articlePageOrigin];
                var articleSection=null;
                for(var si=0;si<d.sections.length;si++){
                    if(d.sections[si].pageStart&&d.sections[si].pageStart.documentOffset===job.articlePageOrigin){articleSection=d.sections[si];break;}
                }
                if(!articleSection){articleSection=d.sections.add();articleSection.pageStart=articleStartPage;}
                articleSection.continueNumbering=false;
                articleSection.pageNumberStart=job.pageNumberStart;
                articleSection.pageNumberStyle=PageNumberStyle.ARABIC;
                articleSection.sectionPrefix="";
                articleSection.includeSectionPrefix=false;
            }
            bind(front.parentStory,"front",bindings);bind(footer.parentStory,"footer",bindings);bind(doi.parentStory,"doi",bindings);bind(body,"body",bindings);
            body.contents="";
            var JournalImportRequest={document:d,target:body.insertionPoints[0],data:prepared,deferRecompose:true};
            eval(read(job.importerPath).replace(/^#target[^\r\n]*[\r\n]*/,""));
            phase("text-imported");
            var library=null;if(job.formulas.mode==="native-library")library=JournalDocumentSession.acquire(appInstance,job.formulas.libraryPath).document;
            var formulaStyle=style(d,"公式");
            if(job.formulas.tabStops)setFormulaTabs(formulaStyle,job.formulas.tabStops);
            else if(job.formulas.centerMm!==undefined){formulaStyle.tabStops.everyItem().remove();formulaStyle.tabStops.add({position:job.formulas.centerMm,alignment:TabStopAlignment.CENTER_ALIGN});formulaStyle.tabStops.add({position:job.formulas.numberTabMm,alignment:TabStopAlignment.RIGHT_ALIGN});}
            for(var i=prepared.blocks.length-1;i>=0;i--){
                var block=prepared.blocks[i],p=body.paragraphs[i];
                if(block.panelIndex!==undefined){p.applyParagraphStyle(style(d,"图注/表名"),true);p.properties={pointSize:.1,leading:.1,spaceBefore:0,spaceAfter:0,keepWithNext:0};continue;}
                if(block.role==="table_gap"){
                    var tableSpec=null;for(var t=0;t<job.tables.length;t++)if(job.tables[t].blockIndex===block.originalIndex)tableSpec=job.tables[t];
                    if(!tableSpec)fail("TABLE_SOURCE",block.originalIndex);
                    table(d,p,supp.tables[tableSpec.sourceIndex].rows,structures.tables[tableSpec.sourceIndex],tableSpec);
                    var title=body.paragraphs[i-1];setTableBreak(title,p,StartParagraph.ANYWHERE);
                }else if(block.role==="body"&&/^\s*[（(]\d+[）)]\s*$/.test(block.text)){
                    formula(d,p,Number(block.text.match(/\d+/)[0]),job,library,block.text);
                }else if(standaloneFormulaNumber(block.text)!==null){
                    formula(d,p,standaloneFormulaNumber(block.text),job,library,block.text);
                }else if(sideBySideFormulaNumbers(block.text)!==null){
                    displayFormulaRow(d,p,job,library);
                }else if(block.role==="figure_caption"){
                    captionBlock(d,p,asset(job,"figure",figureNumber(block)));
                }else{var inlineMarkers=formulaMarkers(block.text);if(inlineMarkers.length)inlineFormulas(d,p,inlineMarkers,job,library);if(block.code)p.justification=Justification.LEFT_ALIGN;}
            }
            phase("objects-inserted");
            JournalFrontmatter.apply(d,{front:front,footer:footer,bodyColumns:[firstLeft,firstRight],topGray:labeled(d,"spacing-guide-top"),bottomGray:labeled(d,"spacing-guide-footer"),separator:labeled(d,"article-footer-separator")},
                {front:frontEntries(supp,job.frontmatter.indices),footer:footerEntries(supp,job.frontmatter.indices)},job.frontmatter.contract);
            if(job.frontmatter.doiText!==null&&job.frontmatter.doiText!==undefined&&String(job.frontmatter.doiText).length)doi.contents=job.frontmatter.doiText;
            if(!plain(doi.contents))fail('TEMPLATE_DOI_REQUIRED');
            var audit=parse(job.auditConfigPath);audit.documentPath=job.outputPath;audit.bindings=bindings;audit.sourceTextFormatting=data.blocks;
            JournalLayout.applyTypography(d,audit);JournalLayout.fitFormulaNumbers(d);JournalLayout.geometry(d,audit);JournalLayout.repairOrphans(d);
            phase("typography-finalized");
            for(i=0;i<job.panels.length;i++)result.panels.push(placePanel(d,body,job.panels[i],i,prepared.captions,job,bindings));
            d.recompose();for(var pvi=0;pvi<result.panels.length;pvi++)for(var pfi=0;pfi<result.panels[pvi].frameIds.length;pfi++)if(item(d,result.panels[pvi].frameIds[pfi]).parentPage.id!==result.panels[pvi].pageId)fail("PANEL_PAGE_DRIFT",pvi);
            for(var pa=0;pa<result.panels.length;pa++)for(var pb=pa+1;pb<result.panels.length;pb++)if(result.panels[pa].pageId===result.panels[pb].pageId)for(var af=0;af<result.panels[pa].frameIds.length;af++)for(var bf=0;bf<result.panels[pb].frameIds.length;bf++){
                var ab=item(d,result.panels[pa].frameIds[af]).geometricBounds,bb=item(d,result.panels[pb].frameIds[bf]).geometricBounds;
                if(Math.min(ab[2],bb[2])-Math.max(ab[0],bb[0])>.02&&Math.min(ab[3],bb[3])-Math.max(ab[1],bb[1])>.02)fail("PANEL_OVERLAP",pa+"/"+pb);
            }
            phase("panels-placed");
            var sourceFormatErrors=JournalLayout.sourceTextFormatting(d,audit,true);if(sourceFormatErrors.length)fail("ASSEMBLY_SOURCE_TEXT_FORMAT",sourceFormatErrors.join(";"));
            if(job.continuedTableTemplatePath){
                result.continuations=JournalLayout.syncContinuedTables(d,JournalDocumentSession.acquire(appInstance,job.continuedTableTemplatePath).document);
                phase("continuations-placed");
            }
            if(job.layoutProfile){
                result.layoutProfile=JournalLayoutProfile.apply(d,body,job.layoutProfile,function(doc,story){return refreshPanels(doc,story,job);});
                JournalLayout.formulaLineSpacing(d,true);result.panels=refreshPanels(d,body,job);
                phase("layout-profile-applied");
            }
            result.addedPages=growBodyPages(d,body,job);
            result.removedBlankPages=trimTrailingBlankPages(d,body);
            result.status="assembled-unchecked";result.bodyOverflow=body.overflows;result.pages=d.pages.length;
            d.preflightOptions.preflightOff=oldPreflight;JournalDocumentSession.save(d,state);
            return result;
        }catch(error){
            result.status="failed";result.failure=String(error);result.line=error.line;
            d.preflightOptions.preflightOff=oldPreflight;JournalDocumentSession.save(d,state);return result;
        }finally{
            d.preflightOptions.preflightOff=oldPreflight;appInstance.scriptPreferences.enableRedraw=oldRedraw;appInstance.scriptPreferences.userInteractionLevel=oldUI;
        }
    }
    return {sourceInlineFormulaParagraph:sourceInlineFormulaParagraph,replaceNativeFormula:replaceNativeFormula,trimTrailingBlankPages:trimTrailingBlankPages,panelRows:panelRows,refreshPanels:refreshPanels,growBodyPages:growBodyPages,defaultTableWidths:defaultTableWidths,lastVisibleIndex:lastVisibleIndex,standaloneFormulaNumber:standaloneFormulaNumber,sideBySideFormulaNumbers:sideBySideFormulaNumbers,displayFormulaRow:displayFormulaRow,formulaMarkers:formulaMarkers,validateFormulaMarkers:validateFormulaMarkers,idmsEntry:idmsEntry,insertNativeFormula:insertNativeFormula,inlineFormulas:inlineFormulas,printedFormulaNumber:printedFormulaNumber,orderPanelFrames:orderPanelFrames,prepareBlocks:prepareBlocks,codeLine:codeLine,clearPayload:clearPayload,setTableBreak:setTableBreak,setFormulaTabs:setFormulaTabs,restoreMasterText:restoreMasterText,normalizeExisting:normalizeExisting,reflowExisting:reflowExisting,layoutExisting:layoutExisting,applyBottomExisting:applyBottomExisting,run:run};
}());
