            result.removedBlankPages=trimTrailingBlankPages(d,body);
            result.pages=d.pages.length;result.bodyOverflow=body.overflows;
            d.insertLabel("journal-assembly-stage","normalized-current-candidate");
            JournalDocumentSession.save(d,state);
            return result;
        }finally{appInstance.scriptPreferences.userInteractionLevel=oldUI;appInstance.scriptPreferences.enableRedraw=oldRedraw;}
    }
    function trimTrailingBlankPages(d,body){
        var removed=0;
        while(d.pages.length>1){
            var page=d.pages[-1],items=page.pageItems.everyItem().getElements(),blank=items.length>0;
            for(var i=0;i<items.length;i++)if(items[i].constructor.name!=="TextFrame"||items[i].parentStory.id!==body.id||plain(items[i].contents))blank=false;
            if(!blank)break;
            var before=String(body.contents);page.remove();d.recompose();
            if(String(body.contents)!==before||body.overflows)fail("TRIM_BODY_CHANGED");removed++;
        }
        return removed;
    }
    function defaultTableWidths(rows,structure){
        var widths=[],minimums=[],sum=0,i,j,needsFit=false;
        for(i=0;i<structure.widths.length;i++){sum+=structure.widths[i];minimums.push(0);}
        for(i=0;i<structure.rows.length;i++)for(j=0;j<structure.rows[i].length;j++){
            var cell=structure.rows[i][j];if(cell.span===1&&/^[\u3400-\u9fff]{2}$/.test(String(rows[i][j]).replace(/\s/g,'')))minimums[cell.start]=7.4;
        }
        var minimumTotal=0,weight=0;
        for(i=0;i<structure.widths.length;i++){widths.push(85.5*structure.widths[i]/sum);minimumTotal+=minimums[i];weight+=Math.max(0,widths[i]-minimums[i]);if(widths[i]<minimums[i])needsFit=true;}
        if(needsFit){if(minimumTotal>85.5||!weight)fail('TABLE_MINIMUM_WIDTH_CAPACITY');for(i=0;i<widths.length;i++)widths[i]=minimums[i]+(85.5-minimumTotal)*Math.max(0,widths[i]-minimums[i])/weight;}
        return widths;
    }
    function table(d,p,rows,structure,spec,job,library) {
        clearPayload(p);p.pointSize=1;p.leading=1;p.spaceBefore=0;p.spaceAfter=0;
        var t=p.insertionPoints[0].tables.add({bodyRowCount:rows.length,columnCount:structure.widths.length});
        t.label="source-table-"+spec.number;
        var widths=spec.widthsMm,sum=0,i,j;
        if(!widths)widths=defaultTableWidths(rows,structure);
        if(widths.length!==t.columns.length)fail("TABLE_WIDTHS",spec.number);
        for(i=0;i<widths.length;i++)t.columns[i].width=widths[i];
        for(i=0;i<structure.rows.length;i++)for(j=structure.rows[i].length-1;j>=0;j--){var c=structure.rows[i][j];if(c.span>1)t.rows[i].cells.itemByRange(c.start,c.start+c.span-1).merge();}
        for(i=0;i<rows.length;i++){
            t.rows[i].autoGrow=true;t.rows[i].minimumHeight=5;
            for(j=0;j<rows[i].length;j++){
                var cell=t.rows[i].cells[j];cell.contents=rows[i][j];cell.texts[0].applyParagraphStyle(style(d,"表格正文默认"),true);
                cell.texts[0].properties={appliedFont:font("现 宋体-1"),pointSize:9,leading:12,justification:Justification.CENTER_ALIGN,noBreak:false};
                cell.properties={topInset:.5,bottomInset:.5,leftInset:.5,rightInset:.5,verticalJustification:VerticalJustification.CENTER_ALIGN,topEdgeStrokeWeight:.5,bottomEdgeStrokeWeight:.5,leftEdgeStrokeWeight:.5,rightEdgeStrokeWeight:.5};
                // Place inline native formulas in cell text immediately after building the cell,
                // while we still hold a direct reference to the cell paragraph.
                if(job&&job.formulas&&job.formulas.mode==="native-idms"){
                    var cellText=rows[i][j],cellMarkers=formulaMarkers(cellText);
                    if(cellMarkers.length){
                        // inlineFormulas uses parentStory which spans across cells; work directly
                        // on the cell paragraph to stay inside the cell context.
                        var cellPara=cell.texts[0].paragraphs[0];
                        inlineCellFormulas(d,cellPara,cell,cellMarkers,job,library);
                    }
                }
            }
        }
        // Source merge metadata is applied by JournalLayout before source character formatting.
        for(i=0;i<structure.headerRows;i++)t.rows[i].rowType=RowTypes.HEADER_ROW;
        return t;
    }
    function inlineCellFormulas(d,para,cell,markers,job,library) {
        // Place native formulas anchored inside a table cell. The cell text lives in
        // its own story, so parentStory.insertionPoints indexes are local to that story.
        for(var i=markers.length-1;i>=0;i--){
            var marker=markers[i];
            var cellStory=cell.texts[0];
            var text=String(cellStory.contents);
            var at=text.indexOf(marker.marker);
            if(at<0)continue;
            var cellInsertionIndex=cellStory.characters[at].index;
            cellStory.characters.itemByRange(at,at+marker.marker.length-1).remove();
            var story=cellStory.parentStory.getElements()[0];
            var r=insertNativeFormula(d,story.insertionPoints[cellInsertionIndex],marker.number,job.formulas,library);
            r.insertLabel("formula-display","false");r.insertLabel("formula-inline","true");
        }
    }
    function placeFigure(d,p,a) {
        var r=d.pages[0].rectangles.add({geometricBounds:[0,0,a.height,a.width],strokeWeight:0,fillColor:d.swatches.itemByName("None")}).getElements()[0];
        if(/\.pdf$/i.test(a.path)){app.pdfPlacePreferences.pageNumber=1;app.pdfPlacePreferences.pdfCrop=PDFCrop.CROP_MEDIA;}
        r.place(File(a.path));r.fit(FitOptions.PROPORTIONALLY);r.fit(FitOptions.FRAME_TO_CONTENT);
        r.anchoredObjectSettings.insertAnchoredObject(p.insertionPoints[0],AnchorPosition.ABOVE_LINE);
        r.anchoredObjectSettings.horizontalAlignment=HorizontalAlignment.CENTER_ALIGN;r.label="source-figure-"+a.number;
        return r;
    }
    function captionBlock(d,p,a) {
        var story=p.parentStory,index=-1;
        for(var i=0;i<story.paragraphs.length;i++)if(story.paragraphs[i].index===p.index)index=i;
        if(index<0)fail("CAPTION_INDEX",a.number);
        p.insertionPoints[0].contents="\r\r";
        var anchor=story.paragraphs[index],gap=story.paragraphs[index+1],caption=story.paragraphs[index+2];
        anchor.applyParagraphStyle(style(d,"图注/表名"),true);
        anchor.properties={pointSize:.1,leading:.1,spaceBefore:0,spaceAfter:0,keepWithNext:2};
        placeFigure(d,anchor,a);
        gap.applyParagraphStyle(style(d,"段落样式1"),true);
        gap.properties={pointSize:9,leading:5,spaceBefore:0,spaceAfter:0,keepWithNext:1};
        caption.applyParagraphStyle(style(d,"图注/表名"),true);
        caption.properties={appliedFont:font("黑体"),fontStyle:"Regular",pointSize:9,leading:14,justification:Justification.CENTER_ALIGN,firstLineIndent:0,spaceBefore:0,spaceAfter:0,keepWithNext:0};
    }
    function nativeFormula(library,n,source) {
        var a=library.allPageItems,found=[],range=source.selector.approvedPageRange;
        for(var i=0;i<a.length;i++){var page=a[i].parentPage;
            if(a[i].label==="source-formula-"+n&&a[i].constructor.name==="Group"&&!a[i].allGraphics.length&&page&&Number(page.name)>=range[0]&&Number(page.name)<=range[1]&&Number(a[i].extractLabel("formula-base-point-size"))===10.5)found.push(a[i]);
        }
        if(found.length!==1)fail("FORMULA_NATIVE_SOURCE",n+"/"+found.length);return found[0];
    }
    function printedFormulaNumber(source, number, sourceText) {
        var value=source.displayNumbers&&source.displayNumbers[String(number)];
        if(value===undefined){if(source.mode==="native-idms")return null;var match=String(sourceText||"").match(/[（(]([0-9]+)[）)]\s*$/);if(match)return match[1];return null;}if(value===null)return null;return String(value);
    }
    function formulaMarkers(text) {
        var re=/⟦EQ-([0-9]+)⟧/g,match,result=[];
        while((match=re.exec(String(text)))!==null)result.push({number:Number(match[1]),marker:match[0],start:match.index});
        return result;
    }
    function standaloneFormulaNumber(text) {
        var match=String(text).match(/^\s*⟦EQ-([0-9]+)⟧\s*(?:[（(][0-9]+[）)]\s*)?$/);
        return match?Number(match[1]):null;
    }
    function validateFormulaMarkers(blocks) {
        var seen={};
        for(var i=0;i<blocks.length;i++){var markers=formulaMarkers(blocks[i].text);for(var j=0;j<markers.length;j++){
            var n=markers[j].number;if(seen[n])fail("FORMULA_MARKER_DUPLICATE",n);seen[n]=true;
        }}
    }
    function idmsEntry(source,n) {
        var found=[];for(var i=0;i<source.entries.length;i++)if(Number(source.entries[i].number)===n)found.push(source.entries[i]);
        if(found.length!==1)fail("FORMULA_IDMS_ENTRY",n+"/"+found.length);return found[0];
    }
    function insertNativeFormula(d,point,n,source,library) {
        var r,entry,anchorStory,anchorIndex;
        if(source.mode==="native-library"||source.mode==="native-idms"){anchorStory=point.parentStory.getElements()[0];anchorIndex=Number(point.index);}
        if(source.mode==="native-library"){
            r=nativeFormula(library,n,source).duplicate(d.pages[0]);
            r.anchoredObjectSettings.insertAnchoredObject(anchorStory.insertionPoints[anchorIndex],AnchorPosition.INLINE_POSITION);
        }else if(source.mode==="native-idms"){
            entry=idmsEntry(source,n);if(!File(entry.path).exists)fail("FORMULA_IDMS_MISSING",n);
            var placed=d.pages[0].place(File(entry.path));if(!placed||placed.length!==1)fail("FORMULA_IDMS_PLACE_COUNT",n);
            r=placed[0].getElements()[0];
            r.anchoredObjectSettings.insertAnchoredObject(anchorStory.insertionPoints[anchorIndex],AnchorPosition.INLINE_POSITION);
            if(Number(r.extractLabel("formula-base-point-size"))!==10.5||r.extractLabel("formula-native-paste")!=="true")fail("FORMULA_NATIVE_PROVENANCE",n);
        }else fail("FORMULA_MODE",source.mode);
        if(r.constructor.name!=="Group"||r.allGraphics.length)fail("FORMULA_NOT_NATIVE_GROUP",n);
        if(Math.abs(r.absoluteHorizontalScale-100)>.01||Math.abs(r.absoluteVerticalScale-100)>.01)fail("FORMULA_SCALE",n);
        var bounds=r.geometricBounds;
        if(entry&&(Math.abs(bounds[3]-bounds[1]-Number(entry.widthMm))>.02||Math.abs(bounds[2]-bounds[0]-Number(entry.heightMm))>.02))fail("FORMULA_NATIVE_SIZE",n);
        r.label="source-formula-"+n;r.insertLabel("formula-native-paste","true");r.insertLabel("formula-base-point-size","10.5");
        if(entry){r.insertLabel("formula-idms-sha256",entry.sha256);if(entry.cacheKey)r.insertLabel("formula-cache-key",entry.cacheKey);if(entry.sourceSha256)r.insertLabel("formula-source-sha256",entry.sourceSha256);if(entry.ruleVersion)r.insertLabel("formula-rule-version",entry.ruleVersion);}
        return r;
    }
    function replaceNativeFormula(d, number, source) {
        var items=d.allPageItems,found=[];
        for(var i=0;i<items.length;i++)if(items[i].label==='source-formula-'+number)found.push(items[i]);
        if(found.length!==1)fail('FORMULA_REPLACEMENT_COUNT',number+'/'+found.length);
        var old=found[0],anchor=old.parent;
        if(anchor.constructor.name!=='Character')fail('FORMULA_REPLACEMENT_ANCHOR',number);
        var story=anchor.parentStory.getElements()[0],index=Number(anchor.index),text=String(story.contents),labels={};
        for(var key in {'formula-display':1,'formula-printed-number':1,'formula-inline':1})labels[key]=old.extractLabel(key);
        var replacement=insertNativeFormula(d,story.insertionPoints[index],number,source,null);
        old.remove();
        for(var key in labels)replacement.insertLabel(key,labels[key]);
        if(String(story.contents)!==text)fail('FORMULA_REPLACEMENT_TEXT_CHANGED',number);
        return replacement;
    }
    // Two or more unnumbered display formulas sharing one source line, separated only by whitespace.
    // Numbered lines keep using formula(); a single marker keeps using standaloneFormulaNumber().
    function sideBySideFormulaNumbers(text) {
        var t=String(text);
        if(!/^\s*⟦EQ-[0-9]+⟧(?:\s+⟦EQ-[0-9]+⟧)+\s*$/.test(t))return null;
        var markers=formulaMarkers(t),out=[];for(var i=0;i<markers.length;i++)out.push(markers[i].number);return out;
    }
    function displayFormulaRow(d,p,job,library) {
        var story=p.parentStory.getElements()[0],start=Number(p.insertionPoints[0].index);
        p.applyParagraphStyle(style(d,"公式"),true);
        var placed=inlineFormulas(d,p,formulaMarkers(p.contents),job,library),tallest=0;
        p=story.insertionPoints[start].paragraphs[0];
        for(var i=0;i<placed.length;i++){
            var g=placed[i];g.insertLabel("formula-display","unnumbered");g.insertLabel("formula-inline","false");
            tallest=Math.max(tallest,g.geometricBounds[2]-g.geometricBounds[0]);
        }
        p.leading=Math.max(15,(tallest+1)*72/25.4);p.spaceBefore=0;p.spaceAfter=0;p.justification=Justification.CENTER_ALIGN;
        return placed;
    }
    function inlineFormulas(d,p,markers,job,library) {
        var placed=[];
        for(var i=markers.length-1;i>=0;i--){
            var marker=markers[i],text=String(p.contents),at=text.indexOf(marker.marker);
            if(at<0||text.indexOf(marker.marker,at+marker.marker.length)>=0)fail("FORMULA_MARKER_COUNT",marker.number);
            var story=p.parentStory,index=p.characters[at].index;
            p.characters.itemByRange(at,at+marker.marker.length-1).remove();
            var r=insertNativeFormula(d,story.insertionPoints[index],marker.number,job.formulas,library);
            r.insertLabel("formula-display","false");r.insertLabel("formula-inline","true");
            r.parent.leading=Math.max(15,(r.geometricBounds[2]-r.geometricBounds[0])*72/25.4+2);
            placed.push(r);
        }
        return placed;
    }
    function formula(d,p,n,job,library,sourceText) {
        var source=job.formulas,r,printed=printedFormulaNumber(source,n,sourceText);
        var sourceNumber=String(sourceText||"").match(/[（(]([0-9]+)[）)]\s*$/);
        if(source.mode==="native-idms"&&sourceNumber&&(printed===null||String(sourceNumber[1])!==printed))fail("FORMULA_DISPLAY_NUMBER_REQUIRED",n);
        var formulaStory=p.parentStory.getElements()[0],formulaStart=Number(p.insertionPoints[0].index);
        p.contents=printed===null?"\r":"\t\t（"+printed+"）\r";p=formulaStory.insertionPoints[formulaStart].paragraphs[0];p.applyParagraphStyle(style(d,"公式"),true);p.justification=Justification.LEFT_ALIGN;
        if(source.mode==="native-library"||source.mode==="native-idms")r=insertNativeFormula(d,p.insertionPoints[printed===null?0:1],n,source,library);
        else if(source.mode==="legacy-pdf"&&job.legacyRegressionFixture===true){
            var a=asset(job,"formula",n);r=d.pages[0].rectangles.add({geometricBounds:[0,0,a.height,a.width],strokeWeight:0,fillColor:d.swatches.itemByName("None")});
            app.pdfPlacePreferences.pdfCrop=PDFCrop.CROP_MEDIA;r.place(File(a.path));r.fit(FitOptions.PROPORTIONALLY);
            r.anchoredObjectSettings.insertAnchoredObject(p.insertionPoints[printed===null?0:1],AnchorPosition.INLINE_POSITION);
        }else fail("FORMULA_MODE",source.mode);
        p.leading=Math.max(15,(r.geometricBounds[2]-r.geometricBounds[0]+1)*72/25.4);p.spaceBefore=0;p.spaceAfter=0;
        if(printed===null)p.justification=Justification.CENTER_ALIGN;
        r.label="source-formula-"+n;r.insertLabel("formula-display",printed===null?"unnumbered":"true");r.insertLabel("formula-inline","false");r.insertLabel("formula-base-point-size","10.5");
        if(printed!==null)r.insertLabel("formula-printed-number",printed);
    }
    function frontEntries(supp,indices) {
        var roles=["cnTitle","cnAuthor","cnAffiliation","cnAbstract","cnKeywords","classification","enTitle","enAuthor","enAffiliation","enAbstract","enKeywords"],out=[];
        for(var i=0;i<roles.length;i++){var v=supp.front[indices[roles[i]]];out.push({role:roles[i],text:v.text,runs:v.runs||[]});}return out;
    }
    function addPage(d,body,g) {
        var previous=d.pages[-1],page=d.pages.add();page.appliedMaster=previous.appliedMaster;
        var x=left(page,g),l=page.textFrames.add({geometricBounds:[g.bodyTopMm,x,g.bodyBottomMm,x+g.columnWidthMm]}),r=page.textFrames.add({geometricBounds:[g.bodyTopMm,x+g.columnWidthMm+g.columnGapMm,g.bodyBottomMm,x+g.spreadWidthMm]});
        l.label="article-body";r.label="article-body";body.textContainers[body.textContainers.length-1].nextTextFrame=l;l.nextTextFrame=r;
    }
    function lastVisibleIndex(body){
        var last=-1,frames=body.textContainers;
        for(var fi=0;fi<frames.length;fi++)for(var li=0;li<frames[fi].lines.length;li++){
            var line=frames[fi].lines[li],owners=line.insertionPoints[0].parentTextFrames;
            if(owners.length&&owners[0].id===frames[fi].id)last=Math.max(last,Number(line.insertionPoints[-1].index));
        }
        return last;
    }
    function growBodyPages(d,body,job){
        if(job.allowPageGrowth!==true)return 0;
        var added=0,original=String(body.contents);d.recompose();
        while(body.overflows){
            var before=lastVisibleIndex(body);addPage(d,body,job.templateContract.geometry);d.recompose();
            if(String(body.contents)!==original)fail("BODY_PAGE_GROWTH_CONTENT_CHANGED");
            var after=lastVisibleIndex(body),frames=body.textContainers,newPage=d.pages[-1],visible=false;
            for(var fi=0;fi<frames.length;fi++)if(frames[fi].parentPage.id===newPage.id)for(var li=0;li<frames[fi].lines.length;li++)if(String(frames[fi].lines[li].contents).replace(/\s/g,""))visible=true;
            if(!visible||after<=before){newPage.remove();d.recompose();if(String(body.contents)!==original)fail("BODY_PAGE_GROWTH_CONTENT_CHANGED");fail("BODY_UNBREAKABLE_FLOW",before+"=>"+after);}
            added++;
        }
        return added;
    }
    function panelParts(d,page,spec,captions,job,bindings) {
        var g=job.templateContract.geometry,parts=[],heights=[],rowY=0,columnWidth=g.spreadWidthMm/spec.columns;
        for(var i=0;i<spec.numbers.length;i++){
            var row=Math.floor(i/spec.columns);if(i&&i%spec.columns===0)rowY+=heights[row-1]+4;
            var a=asset(job,"figure",spec.numbers[i]),x=left(page,g)+(i%spec.columns)*columnWidth;
            var f=page.textFrames.add({geometricBounds:[rowY,x,rowY+a.height+15,x+columnWidth]}).getElements()[0];
            f.contents=captions[a.number];captionBlock(d,f.paragraphs[0],a);f.fit(FitOptions.FRAME_TO_CONTENT);f.label="figure-band-caption-"+a.number;
            bind(f.parentStory,"figureCaption",bindings);parts.push(f);heights[row]=Math.max(heights[row]||0,f.geometricBounds[2]-f.geometricBounds[0]);
        }
        return {frames:parts,rowHeights:heights,height:rowY+heights[heights.length-1]};
    }
    function placePanel(d,body,spec,index,captions,job,bindings) {
        var marker=findParagraph(body,"JOURNAL_PANEL_"+index),g=job.templateContract.geometry;
        if(spec.pageTop===true){marker.startParagraph=StartParagraph.NEXT_PAGE;d.recompose();}
        var owners=marker.insertionPoints[0].parentTextFrames;if(!owners.length)fail("PANEL_OVERSET",index);
        var page=owners[0].parentPage.getElements()[0],frames=body.textContainers,pair=[];
