                    var bounds=topFrames[ti].geometricBounds;bounds[0]=g.bodyTopMm+topHeight+4;topFrames[ti].geometricBounds=bounds;
                }
                if(fillPreceding===true&&spec.keepFollowingAfterPanel===true)JournalReflow.fillBeforePanel(d,body,spec.afterParagraphText,topPage.documentOffset);
                out.push({index:index,pageIndex:topPage.documentOffset,pageTop:true});continue;
            }
