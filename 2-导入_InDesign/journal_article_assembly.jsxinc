/* One document, one import, typography before all measured wide-panel placement. */
var JournalArticleAssembly = (function () {
    function orderPanelFrames(frames){
        frames.sort(function(a,b){var delta=a.geometricBounds[2]-b.geometricBounds[2];return Math.abs(delta)>.1?delta:a.geometricBounds[1]-b.geometricBounds[1];});
        return frames;
    }
    function fail(code, detail) { throw Error(code + (detail === undefined ? "" : " " + detail)); }
    function read(path) { var f=File(path); f.encoding="UTF-8"; if(!f.open("r"))fail("READ",path);var s=f.read();f.close();return s; }
    function parse(path) { return eval("("+read(path)+")"); }
    function style(d, name) { var a=d.allParagraphStyles;for(var i=0;i<a.length;i++)if(a[i].name===name)return a[i];fail("STYLE",name); }
    function font(name) { var f=app.fonts.itemByName(name);if(!f.isValid||f.status!==FontStatus.INSTALLED)fail("FONT",name);return f; }
    function slot(d,name) { var a=d.allPageItems,found=[];for(var i=0;i<a.length;i++){var names=String(a[i].extractLabel("journal-slot-aliases")).split(",");for(var j=0;j<names.length;j++)if(names[j]===name)found.push(a[i]);}if(found.length!==1)fail("SLOT_COUNT",name);return found[0]; }
    function labeled(d,name) { var a=d.allPageItems;for(var i=0;i<a.length;i++)if(a[i].label===name)return a[i];fail("LABEL",name); }
    function plain(text) { return String(text).replace(/[\s\uFFFC\u0016]/g,""); }
    function footerEntries(supplement,indices) { var entries=[{role:"received",text:supplement.received}],fund=supplement.front[indices.fund];if(fund&&plain(fund.text))entries.push({role:"fund",text:fund.text});return entries; }
    function figureNumber(block) { var m=String(block.text).match(/^图\s*(\d+)\s/);return block.role==="figure_caption"&&m?Number(m[1]):null; }
    function codeLine(text) {
        text=String(text);
        return /^\s*(\/\/|\/\*|\*|#|@[A-Za-z_$])/.test(text)||
            /^\s*(import|export|return|const|let|private|public|async|def|if|else|elif|try|except|finally|with)\b/.test(text)||
            /^\s*[{}]/.test(text)||/^\s*['"][A-Za-z_$][^'"]*['"]\s*:/.test(text)||
            /^\s*[A-Za-z_$][\w.$]*(?:\s*,\s*[A-Za-z_$][\w.$]*)*\s*=/.test(text)||
            /^\s*[A-Za-z_$][\w.$]*\(.*\)\s*;?\s*$/.test(text);
    }
    function prepareBlocks(data, panels) {
        var result=[],captions={},markers={},i,j;
        for(i=0;i<data.blocks.length;i++){var n=figureNumber(data.blocks[i]);if(n!==null){if(captions[n])fail("DUPLICATE_FIGURE",n);captions[n]=data.blocks[i].text;}}
        for(i=0;i<panels.length;i++){
            var panel=panels[i],anchor=-1,matchCount=0;
            for(j=0;j<data.blocks.length;j++){
                if(panel.afterParagraphText&&plain(data.blocks[j].text)===plain(panel.afterParagraphText)){anchor=j;matchCount++;}
                else if(!panel.afterParagraphText&&figureNumber(data.blocks[j])===panel.numbers[panel.numbers.length-1]){anchor=j;matchCount++;}
            }
            if(matchCount!==1)fail("PANEL_ANCHOR",i+" matches="+matchCount);
            if(markers[anchor])fail("PANEL_ANCHOR_COLLISION",i);
            markers[anchor]=i;
        }
        for(i=0;i<data.blocks.length;i++){
            var block=data.blocks[i],number=figureNumber(block),consumed=false;
            for(j=0;j<panels.length;j++)for(var k=0;k<panels[j].numbers.length;k++)if(number===panels[j].numbers[k])consumed=true;
            if(!consumed&&!(block.role==="figure_caption"&&!block.text)){
                result.push({role:block.role,text:block.text,runs:block.runs||[],originalIndex:i,code:codeLine(block.text)});
            }
            if(markers[i]!==undefined)result.push({role:"blank",text:"JOURNAL_PANEL_"+markers[i],runs:[],panelIndex:markers[i],originalIndex:null});
        }
        return {blocks:result,captions:captions};
    }
    function clearPayload(p) {
        // Replacing the whole paragraph (including its return) transfers its style to the next paragraph.
        if(p.characters.length>1)p.characters.itemByRange(0,p.characters.length-2).remove();
    }
    function findParagraph(body, value) { var found=[];for(var i=0;i<body.paragraphs.length;i++)if(String(body.paragraphs[i].contents).indexOf(value)===0)found.push(body.paragraphs[i]);if(found.length!==1)fail("PARAGRAPH_LOCATOR",value+" count="+found.length);return found[0]; }
    function item(d,id) { var a=d.allPageItems;for(var i=0;i<a.length;i++)if(a[i].id===id)return a[i];fail("PAGE_ITEM",id); }
    function left(page,g) { return page.side===PageSideOptions.LEFT_HAND?g.leftPageLeftMm:g.rightPageLeftMm; }
    function asset(job,kind,n) { for(var i=0;i<job.assets.length;i++)if(job.assets[i].kind===kind&&Number(job.assets[i].number)===n)return job.assets[i];fail("ASSET",kind+"/"+n); }
    function bind(story,role,bindings) { story.insertLabel("journal-role",role);bindings.push({id:story.id,role:role}); }
    function setTableBreak(caption,anchor,value) {
        caption.startParagraph=value;caption.keepWithNext=1;
        anchor.startParagraph=StartParagraph.ANYWHERE;
    }
    function setFormulaTabs(target,stops) {
        if(!stops||stops.length<2)fail("FORMULA_TAB_CONTRACT");
        target.justification=Justification.LEFT_ALIGN;
        target.tabStops.everyItem().remove();
        for(var i=0;i<stops.length;i++)target.tabStops.add({position:Number(stops[i].position),alignment:Number(stops[i].alignment),
            leader:stops[i].leader||"",alignmentCharacter:stops[i].alignmentCharacter||"."});
    }
    function restoreMasterText(d,source) {
        var manifest=[],restored=0;
        for(var mi=0;mi<source.masterSpreads.length;mi++){
            var sm=source.masterSpreads[mi],tm=d.masterSpreads.itemByName(sm.name);
            if(!tm.isValid||tm.pages.length!==sm.pages.length)fail("MASTER_STRUCTURE",sm.name);
            for(var pi=0;pi<sm.pages.length;pi++){
                var sourceFrames=sm.pages[pi].allPageItems;
                for(var fi=0;fi<sourceFrames.length;fi++){
                    var sf=sourceFrames[fi];if(sf.constructor.name!=="TextFrame")continue;
                    var sb=sf.geometricBounds,match=[],targets=tm.pages[pi].allPageItems;
                    for(var ti=0;ti<targets.length;ti++){
                        if(targets[ti].constructor.name!=="TextFrame")continue;
                        var tb=targets[ti].geometricBounds,near=true;
                        for(var edge=0;edge<4;edge++)if(Math.abs(sb[edge]-tb[edge])>.02)near=false;
                        if(near)match.push(targets[ti]);
                    }
                    if(match.length>1)fail("MASTER_TEXT_DUPLICATE",sm.name+"/"+pi+"/"+fi);
                    if(!match.length){
                        var copy=sf.duplicate(tm.pages[pi]);copy.geometricBounds=sb;restored++;
                    }else if(String(match[0].contents)!==String(sf.contents))fail("MASTER_TEXT_CHANGED",sm.name+"/"+pi+"/"+fi);
                    manifest.push({masterName:String(sm.name),pageIndex:pi,bounds:sb,text:String(sf.contents)});
                }
            }
        }
        return {restored:restored,manifest:manifest};
    }
    function sourceInlineFormulaParagraph(p,source){
        var items=p.allPageItems,found=0;if(!source||!source.entries)return false;
        for(var i=0;i<items.length;i++)if(/^source-formula-/.test(items[i].label)){
            var entry=idmsEntry(source,Number(items[i].label.replace('source-formula-','')));
            if(entry.inline!==true)return false;found++;
        }
        return found>0;
    }
    function normalizeExisting(appInstance,job) {
        var state=JournalDocumentSession.acquire(appInstance,job.outputPath),d=state.document;
        if(d.id!==job.continuation.documentId)fail("DOCUMENT_ID_CHANGED");
        var oldUI=appInstance.scriptPreferences.userInteractionLevel,oldRedraw=appInstance.scriptPreferences.enableRedraw;
        var result={status:"normalized-unchecked",documentId:d.id,outputPath:job.outputPath,codeParagraphs:0,repairedOrphans:0};
        try{
            appInstance.scriptPreferences.userInteractionLevel=UserInteractionLevels.NEVER_INTERACT;
            appInstance.scriptPreferences.enableRedraw=false;
            var body=slot(d,"body-left").parentStory;
            result.finalPageRecovery=JournalLayout.prepareFinalPageReflow(d);
            d.recompose();
            var sourceBlocks=parse(job.logicalArticlePath).blocks,sourceHasJoiner=false;
            if(job.formulas&&job.formulas.mode==='native-idms'){
                var sourceNumberErrors=JournalLayout.sourceFormulaNumbering(d,{formulaNumbers:job.formulas.entries},true);
                if(sourceNumberErrors.length)fail('SOURCE_FORMULA_NUMBER',sourceNumberErrors.join(';'));
            }
            for(var sbi=0;sbi<sourceBlocks.length;sbi++)if(String(sourceBlocks[sbi].text).indexOf(String.fromCharCode(8288))>=0)sourceHasJoiner=true;
            if(!sourceHasJoiner)for(var jpi=0;jpi<body.paragraphs.length;jpi++)if(String(body.paragraphs[jpi].contents)===String.fromCharCode(8288)+"\r")body.paragraphs[jpi].characters[0].remove();
            for(var fci=1;fci<body.paragraphs.length;fci++)if(/^图\s*\d+\s/.test(String(body.paragraphs[fci].contents))){
                var previousCaption=body.paragraphs[fci-1],anchoredFigures=previousCaption.allGraphics;
                if(anchoredFigures.length===1&&/^source-figure-/.test(anchoredFigures[0].parent.label)){
                    body.paragraphs[fci].insertionPoints[0].contents="\r";
                    previousCaption.applyParagraphStyle(style(d,"图注/表名"),true);previousCaption.properties={pointSize:.1,leading:.1,spaceBefore:0,spaceAfter:0,keepWithNext:2};
                    var newGap=body.paragraphs[fci];newGap.applyParagraphStyle(style(d,"段落样式1"),true);newGap.properties={pointSize:9,leading:5,spaceBefore:0,spaceAfter:0,keepWithNext:1};fci++;
                }
            }
            if(job.frontmatter.restoreSourceFormatting===true){
                var supplement=parse(job.supplementPath);
                JournalFrontmatter.apply(d,{front:slot(d,"front-title"),footer:slot(d,"received-fund"),bodyColumns:[slot(d,"body-left"),slot(d,"body-right")],topGray:labeled(d,"spacing-guide-top"),bottomGray:labeled(d,"spacing-guide-footer"),separator:labeled(d,"article-footer-separator")},
                    {front:frontEntries(supplement,job.frontmatter.indices),footer:footerEntries(supplement,job.frontmatter.indices)},job.frontmatter.contract);
                var auditConfig=parse(job.auditConfigPath);auditConfig.sourceTextFormatting=parse(job.logicalArticlePath).blocks;auditConfig.bindings=[];
                for(var asi=0;asi<d.stories.length;asi++){var ar=d.stories[asi].extractLabel("journal-role");if(ar)auditConfig.bindings.push({id:d.stories[asi].id,role:ar});}
                JournalLayout.applyTypography(d,auditConfig);JournalLayout.geometry(d,auditConfig);
            }
            for(var i=0;i<body.paragraphs.length;i++){
                var p=body.paragraphs[i],name=String(p.appliedParagraphStyle.name);
                if(!String(p.contents).replace(/[\s\uFFFC，,]/g,"")){
                    var nativeHeight=0,nativeItems=d.allPageItems;
                    for(var nfi=0;nfi<nativeItems.length;nfi++)if(/^source-formula-/.test(nativeItems[nfi].label)&&nativeItems[nfi].parent.constructor.name==="Character"&&nativeItems[nfi].parent.parentStory.id===body.id&&nativeItems[nfi].parent.paragraphs[0].index===p.index){var nfb=nativeItems[nfi].geometricBounds;nativeHeight=Math.max(nativeHeight,nfb[2]-nfb[0]);}
                    if(nativeHeight&&!sourceInlineFormulaParagraph(p,job.formulas)){p.applyParagraphStyle(style(d,"公式"),true);p.leading=Math.max(15,nativeHeight*72/25.4+2);p.justification=Justification.CENTER_ALIGN;p.firstLineIndent=0;p.spaceBefore=0;p.spaceAfter=0;for(nfi=0;nfi<nativeItems.length;nfi++)if(/^source-formula-/.test(nativeItems[nfi].label)&&nativeItems[nfi].parent.constructor.name==="Character"&&nativeItems[nfi].parent.parentStory.id===body.id&&nativeItems[nfi].parent.paragraphs[0].index===p.index)nativeItems[nfi].insertLabel("formula-display","unnumbered");continue;}
                }
                if((name==="正文_wrd_1"||name==="正文"||name.indexOf("期刊正文_")===0)&&codeLine(p.contents)){
                    p.justification=Justification.LEFT_ALIGN;result.codeParagraphs++;
                }
                if(name==="公式"){
                    p.justification=/[（(][0-9]+[）)]/.test(String(p.contents))?Justification.LEFT_ALIGN:Justification.CENTER_ALIGN;
                    if(job.formulas.tabStops)setFormulaTabs(p,job.formulas.tabStops);
                    var formulaText=String(p.contents),numberMatch=formulaText.match(/[（(][0-9]+[）)]/),objectAt=formulaText.lastIndexOf(String.fromCharCode(65532));
                    if(numberMatch&&objectAt>=0){var numberAt=formulaText.indexOf(numberMatch[0]);if(numberAt>objectAt+1&&/^\s+$/.test(formulaText.substring(objectAt+1,numberAt)))p.characters.itemByRange(objectAt+1,numberAt-1).contents="\t";}
                }
            }

            JournalLayout.formulaLineSpacing(d,true);JournalLayout.fitFormulaNumbers(d);
            result.repairedOrphans=JournalLayout.repairOrphans(d);
            if(job.frontmatter.restoreSourceFormatting===true)result.panels=refreshPanels(d,body,job,true);
            if(job.templateComponents){
                result.masterText=JournalDocumentSession.withReadOnlyDocument(appInstance,job.templateComponents.sourcePath,function(source){
                    if(source.modified)fail("TEMPLATE_COMPONENT_SOURCE_UNSAVED");
                    return restoreMasterText(d,source);
