            var lowerLeft=page.textFrames.add({geometricBounds:[hi+parts.height+8,x,g.bodyBottomMm,x+g.columnWidthMm]}),lowerRight=page.textFrames.add({geometricBounds:[hi+parts.height+8,x+g.columnWidthMm+g.columnGapMm,g.bodyBottomMm,x+g.spreadWidthMm]});
