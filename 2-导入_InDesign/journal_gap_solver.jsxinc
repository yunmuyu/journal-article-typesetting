/* Bounded pagination decisions; the adapter owns composition and rollback. */
var JournalGapSolver=(function(){
    function options(c){
        c=c||{};var o={maxBlankMm:12,maxWindowFrames:4,maxCandidates:6,maxBoundaries:3,maxMilliseconds:30000};
        for(var k in o)if(c[k]!==undefined)o[k]=Number(c[k]);
        for(k in o)if(!isFinite(o[k]))throw Error('GAP_OPTIONS_INVALID');
        if(!(o.maxBlankMm>0)||o.maxWindowFrames<1||o.maxWindowFrames>4||o.maxWindowFrames!==Math.floor(o.maxWindowFrames)||o.maxCandidates<1||o.maxCandidates>6||o.maxCandidates!==Math.floor(o.maxCandidates)||o.maxBoundaries<1||o.maxBoundaries>10||o.maxBoundaries!==Math.floor(o.maxBoundaries)||o.maxMilliseconds<100||o.maxMilliseconds>120000)throw Error('GAP_OPTIONS_INVALID');
        return o;
    }
    function score(state,o,cost){
        var count=0,total=0,max=0;
        for(var i=0;i<state.columns.length;i++){
            var f=state.columns[i];if(!f.hasLaterContent)continue;
            if(f.nextBlock&&f.nextBlock.breakControl&&f.nextBlock.breakControl.releasable)count++;
            var excess=Math.max(0,f.blankMm-o.maxBlankMm);if(excess>.05)count++;
            total+=excess;max=Math.max(max,excess);
        }
        return [count,total,max,cost||0];
    }
    function unresolved(state,o){var result=[];for(var finalIndex=0;finalIndex<state.columns.length;finalIndex++){var value=state.columns[finalIndex];if(!value.hasLaterContent)continue;var excess=Math.max(0,Number(value.blankMm)-Number(o.maxBlankMm)),automatic=value.nextBlock&&value.nextBlock.breakControl&&value.nextBlock.breakControl.releasable;if(excess>0.05||automatic)result.push({frameId:value.id,page:value.pageName,blankMm:value.blankMm,reason:automatic?'stale-automatic-break':'large-gap'});}return result;}
    function better(a,b){for(var i=0;i<a.length;i++){if(a[i]<b[i]-.01)return true;if(a[i]>b[i]+.01)return false;}return false;}
    function plan(state,targetIndex,c){
        var o=options(c),target=state.columns[targetIndex],result={candidates:[],skipped:[]},scopes=[1,2,4],seen={};
        if(!target||!target.nextBlock||!target.hasLaterContent)return result;
        var control=target.nextBlock.breakControl;
        if(control&&control.releasable)result.candidates.push({mode:'release-break',firstFrame:targetIndex,lastFrame:targetIndex,capacityMm:target.blankMm,neededMm:0,cost:0,blockStart:target.nextBlock.startIndex,operations:[{kind:'column-break',target:{paragraphStart:control.paragraphStart},from:control.from,reason:control.reason}]});
        if(control&&control.releasable&&target.restorableFrames){var capacityOps=result.candidates[0].operations;for(var fi=target.restorableFrames.length-1;fi>=0;fi--){var f=target.restorableFrames[fi];capacityOps.unshift({kind:'frame-capacity',target:{frameIndex:f.frameIndex},from:f.from,to:f.to});}}
        if(target.blankMm<=o.maxBlankMm)return result;
        for(var modeIndex=0;modeIndex<2;modeIndex++)for(var si=0;si<scopes.length;si++){
            var mode=modeIndex===0?'pull':'push',start=Math.max(0,targetIndex-Math.min(scopes[si],o.maxWindowFrames)+1),key=mode+':'+start;
            if(seen[key])continue;seen[key]=true;
            var capacity=0,eligible=[];
            for(var i=start;i<=targetIndex;i++)for(var j=0;j<state.columns[i].adjustments.length;j++){
                var a=state.columns[i].adjustments[j],room=mode==='pull'?a.downMm:a.upMm;
                if(room>0){eligible.push(a);capacity+=room;}
            }
            var need=mode==='pull'?Math.max(.05,Number(target.nextBlock.minimumAdvanceMm)-target.blankMm+.5):Math.max(0,target.blankMm-o.maxBlankMm+.5);
            if(!isFinite(need)||capacity+.001<need){result.skipped.push({mode:mode,firstFrame:start,lastFrame:targetIndex,capacityMm:capacity,neededMm:need,reason:'insufficient-budget'});continue;}
            var ratio=Math.min(1,need/capacity),ops=[],cost=0;
            // Use the full compression allowance once; actual reflow decides whether it suffices.
            if(mode==='pull')ratio=1;
            for(i=0;i<eligible.length;i++){
                a=eligible[i];var to=a.from+(mode==='pull'?a.min-a.from:a.max-a.from)*ratio;
                if(Math.abs(to-a.from)<.00001)continue;
                ops.push({key:a.key,kind:a.kind,target:a.target,from:a.from,to:to,min:a.min,max:a.max});
                cost+=Math.abs(to-a.from)*a.costWeight;
            }
            result.candidates.push({mode:mode,firstFrame:start,lastFrame:targetIndex,capacityMm:capacity,neededMm:need,operations:ops,cost:cost,blockStart:target.nextBlock.startIndex});
        }
        result.candidates=result.candidates.slice(0,o.maxCandidates);return result;
    }
    function solve(adapter,c){
        var o=options(c),start=adapter.now(),initial=adapter.measure(),current=initial,decisions=[],visited={},attempts=0,timedOut=false;
        if(initial.hardErrors.length)throw Error('GAP_BASELINE_INVALID '+initial.hardErrors.join(';'));
        for(var bi=0;bi<o.maxBoundaries;bi++){
            var ti=-1,worst=0;
            for(var i=0;i<current.columns.length;i++){
                var col=current.columns[i],key=col.id+':'+(col.nextBlock?col.nextBlock.startIndex:'none');
                var automatic=col.nextBlock&&col.nextBlock.breakControl&&col.nextBlock.breakControl.releasable,priority=automatic?1000000+col.blankMm:col.blankMm;
                if(col.hasLaterContent&&(automatic||col.blankMm>o.maxBlankMm+.05)&&!visited[key]&&priority>worst){ti=i;worst=priority;}
            }
            if(ti<0)break;
            col=current.columns[ti];visited[col.id+':'+(col.nextBlock?col.nextBlock.startIndex:'none')]=true;
            var p=plan(current,ti,o),baseline=adapter.snapshot(current),best=null,bestScore=score(current,o,0),entry={frameId:col.id,page:col.pageName,beforeBlankMm:col.blankMm,nextBlock:col.nextBlock,skipped:p.skipped,trials:[],selected:null};
            for(i=0;i<p.candidates.length;i++){
                if(adapter.now()-start>=o.maxMilliseconds){timedOut=true;break;}
                var candidate=p.candidates[i],trial={mode:candidate.mode,firstFrame:candidate.firstFrame,lastFrame:candidate.lastFrame,capacityMm:candidate.capacityMm,neededMm:candidate.neededMm},after=null;
                if(best&&bestScore[0]===0&&bestScore[1]===0&&bestScore[2]===0&&candidate.cost>=bestScore[3]-.01){entry.skipped.push({mode:candidate.mode,firstFrame:candidate.firstFrame,lastFrame:candidate.lastFrame,reason:'score-lower-bound',cost:candidate.cost});continue;}
                try{
                    adapter.apply(candidate);attempts++;after=adapter.measure();
                    var errors=adapter.validate(baseline,after,candidate);
                    if(!errors.length&&candidate.mode==='pull'&&!adapter.blockInFrame(candidate.blockStart,col.id))errors.push('block-not-retained');
                    trial.errors=errors;
                    if(!errors.length){trial.score=score(after,o,candidate.cost);trial.blankMm=after.columns[ti].blankMm;
                        if(better(trial.score,bestScore)){best=candidate;bestScore=trial.score;}}
                }catch(e){trial.errors=[String(e)];}
                finally{adapter.restore(baseline);}
                entry.trials.push(trial);
            }
            if(best){
                try{
                    adapter.apply(best);var accepted=adapter.measure(),issues=adapter.validate(baseline,accepted,best);
                    if(issues.length||!better(score(accepted,o,best.cost),score(current,o,0)))throw Error('GAP_REPLAY_NOT_IMPROVED '+issues.join(';'));
                    if(best.mode==='pull'&&!adapter.blockInFrame(best.blockStart,col.id))throw Error('GAP_REPLAY_BLOCK_NOT_RETAINED');
                    current=accepted;entry.selected={mode:best.mode,firstFrame:best.firstFrame,lastFrame:best.lastFrame,operations:best.operations,afterBlankMm:current.columns[ti].blankMm};
                }catch(e){adapter.restore(baseline);entry.replayError=String(e);current=adapter.measure();}
            }
            decisions.push(entry);if(timedOut)break;
        }
        var remaining=unresolved(current,o);
        if(!remaining.length&&score(current,o,0)[0]>0)remaining.push({reason:'gap-state-inconsistent'});
        var applied=0;for(i=0;i<decisions.length;i++)if(decisions[i].selected)applied++;
        return {schemaVersion:1,status:remaining.length?'blocked-large-gaps':'gap-check-passed',fullArticleAcceptance:false,elapsedMs:adapter.now()-start,timedOut:timedOut,trialCount:attempts,appliedDecisions:applied,limits:o,beforeScore:score(initial,o,0),afterScore:score(current,o,0),decisions:decisions,remaining:remaining};
    }
    return {options:options,score:score,better:better,plan:plan,solve:solve,unresolved:unresolved};
})();
