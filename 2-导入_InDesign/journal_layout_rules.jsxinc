/* InDesign 2020 / ExtendScript ES3. Shared production rules; no article IDs. */

var JournalLayout = (function () {

    var R = {bodyFont:'现 宋体-1', bodySize:10.5, minLeading:14.8, maxLeading:16,

        captionGap:5, topGap:8.75, footerGap:5.5, footerInkGap:8.668790147681, footerGuideOffset:0.889113498331, metadataFrameInset:1.356145536731, bottomInset:0.655475157077, tolerance:.01};

    function bodyLeadingLimit(tr,c){var limit=R.maxLeading,items=c.leadingExceptions||[];for(var i=0;i<items.length;i++){var e=items[i];if(!e.reason||typeof e.maxPt!=='number'||e.maxPt<=R.maxLeading||e.maxPt>R.maxLeading+.05)continue;if(tr.parentStory.id===e.storyId&&tr.characters.length&&tr.characters[0].index>=e.startIndex&&tr.characters[-1].index<=e.endIndex)limit=Math.max(limit,e.maxPt);}return limit;}

    function bodyLeadingMinimum(tr,c){var limit=R.minLeading,items=c.leadingExceptions||[];for(var i=0;i<items.length;i++){var e=items[i];if(e.userApproved!==true||!e.reason||typeof e.minPt!=='number'||e.minPt>=R.minLeading||e.minPt<R.minLeading-.100001)continue;if(tr.parentStory.id===e.storyId&&tr.characters.length&&tr.characters[0].index>=e.startIndex&&tr.characters[-1].index<=e.endIndex)limit=Math.min(limit,e.minPt);}return limit;}

    function meaningful(s){return String(s).replace(/[\s\uFFFC\u0016]/g,'');}

    function font(name){var f=app.fonts.itemByName(name);if(!f.isValid||f.status!==FontStatus.INSTALLED)throw Error('FONT_UNAVAILABLE '+name);return f;}

    function family(r){return String(r.appliedFont.name).split(String.fromCharCode(9))[0];}

    function graphicIsCropped(frameBounds,graphicBounds){return graphicBounds[0]<frameBounds[0]-.03||graphicBounds[1]<frameBounds[1]-.03||graphicBounds[2]>frameBounds[2]+.03||graphicBounds[3]>frameBounds[3]+.03;}

    function sourceCaptionRange(p,tr,c){

        if(!c.sourceCaptionRuns||!tr.characters.length||!/^[A-Za-z]+$/.test(String(tr.contents)))return false;

        var start=tr.characters[0].index-p.insertionPoints[0].index,text=String(p.contents).replace(/\r$/,"");

        for(var i=0;i<c.sourceCaptionRuns.length;i++){

            var spec=c.sourceCaptionRuns[i];if(spec.paragraphText!==text)continue;

            if(text.substring(start,start+String(tr.contents).length)!==String(tr.contents))return false;

            for(var k=0;k<String(tr.contents).length;k++){

                var matched=false;

                for(var j=0;j<spec.runs.length;j++){

                    var run=spec.runs[j];

                    if(start+k>=run.start&&start+k<run.end&&run.italic===/Italic/.test(String(tr.fontStyle))&&sourcePosition(run.position)===tr.position)matched=true;

                }

                if(!matched)return false;

            }

            return true;

        }

        return false;

    }

    function list(d,role){var a=[];for(var i=0;i<d.stories.length;i++)if(d.stories[i].extractLabel('journal-role')===role)a.push(d.stories[i]);return a;}

    function one(d,role){var a=list(d,role);if(a.length!==1)throw Error('BINDING '+role+' count '+a.length);return a[0];}

    function assertQA(d){if(!/(QA|copy|副本)/i.test(d.name))throw Error('QA_COPY_REQUIRED');}

    function bind(d,c,apply){assertQA(d);for(var i=0;i<c.bindings.length;i++){var b=c.bindings[i],s=d.stories.itemByID(b.id);if(!s.isValid)throw Error('BINDING_MISSING '+b.id);if(s.extractLabel('journal-role')!==b.role){if(!apply)throw Error('BINDING_ROLE_MISMATCH '+b.id+' expected='+b.role+' actual='+s.extractLabel('journal-role'));s.insertLabel('journal-role',b.role);}}}

    function scope(d){var a=[];for(var i=0;i<d.stories.length;i++)if(d.stories[i].extractLabel('journal-role'))a.push(d.stories[i]);return a;}

    function role(p,scopeRole){

        var t=String(p.contents),n=String(p.appliedParagraphStyle.name).replace(/^journal-[^:]+::/,'');

        if(!meaningful(t))return 'empty';

        if(scopeRole==='doi')return 'doi';if(scopeRole==='tableContinuation')return 'tableContinuation';

        if(/^收稿日期/.test(t))return 'received';if(/^基金项目/.test(t))return 'fund';

        if(/^作者简介/.test(t))return 'bio';

        if(n==='英文摘要')return 'english';if(n==='正文_wrd_1'||n==='正文'||n.indexOf('期刊正文_')===0)return 'body';

        if(n==='一级标题')return 'h1';if(n==='二级标题')return 'h2';

        if(n==='图注/表名')return 'caption';if(n==='参考文献 内容')return 'reference';

        if(n==='参考文献 标题')return 'referenceTitle';if(n==='公式')return 'formula';

        if(n==='大标题')return 'cnTitle';if(n==='作者')return 'cnAuthor';if(n==='作者单位')return 'cnAffiliation';

        if(n==='中文摘要')return 'cnAbstract';if(n.indexOf('中图分类号')>=0)return 'classification';

        if(n==='英语大标题'||n==='英文大标题')return 'enTitle';if(n==='英语作者')return 'enAuthor';if(n==='英文作者单位')return 'enAffiliation';

        return 'unknown';

    }

    function articleTables(d){var a=[],stories=scope(d);for(var i=0;i<stories.length;i++){var roleName=stories[i].extractLabel('journal-role');if(roleName!=='body'&&roleName!=='tables')continue;for(var j=0;j<stories[i].tables.length;j++)a.push(stories[i].tables[j]);}a.sort(function(a,b){return Number(a.label.replace('source-table-',''))-Number(b.label.replace('source-table-',''));});return a;}

    function continuationFrames(d){
        var result=[],stories=scope(d);
        for(var i=0;i<stories.length;i++)if(stories[i].extractLabel('journal-role')==='body'||stories[i].extractLabel('journal-role')==='tables'){
            var containers=stories[i].textContainers||[];for(var j=0;j<containers.length;j++)result.push(containers[j]);
        }
        if(!result.length&&d.textFrames)for(i=0;i<d.textFrames.length;i++){
            var frame=d.textFrames[i],frameRole=frame.parentStory.extractLabel('journal-role');
            if(frameRole==='body'||frameRole==='tables')result.push(frame);
        }
        return result;
    }

    function continuedTableFragments(d){
        var tables=articleTables(d),out=[];
        for(var ti=0;ti<tables.length;ti++){
            var table=tables[ti],seen={},first=null;
            for(var ri=0;ri<table.rows.length;ri++)for(var ci=0;ci<table.rows[ri].cells.length;ci++){
                var lines=table.rows[ri].cells[ci].texts[0].lines;
                for(var li=0;li<lines.length;li++){
                    var owners=lines[li].insertionPoints[0].parentTextFrames;if(!owners.length)continue;
                    var frame=owners[0];
                    if(frame.textFramePreferences&&Number(frame.textFramePreferences.textColumnCount)>1)throw Error('CONTINUATION_MULTICOLUMN_UNSUPPORTED '+table.label);
                    if(first===null)first=frame.id;
                    if(frame.id!==first&&!seen[frame.id])out.push({tableLabel:table.label,frame:frame,key:'journal-continued-'+table.label+'-'+frame.id});
                    seen[frame.id]=true;
                }
            }
        }
        return out;
    }

    function syncContinuedTables(d,library){
        var template=null;
        for(var ti=0;ti<library.textFrames.length;ti++){
            var candidate=library.textFrames[ti];
            if(/^[（(]续表[）)]$/.test(meaningful(candidate.contents))&&Number(candidate.paragraphs[0].pointSize)===9&&Number(candidate.paragraphs[0].leading)===12){template=candidate;break;}
        }
        if(!template)throw Error('CONTINUATION_TEMPLATE_REQUIRED');
        var height=template.geometricBounds[2]-template.geometricBounds[0],tables=articleTables(d),tableLabels={},frameIds={},frames=[],frameRecords=[],markers=[],created=[],fragments,pass=0,seenStates={},restored=0,removed=0;
        var stories=scope(d),overflowBefore=[];
        for(var si=0;si<stories.length;si++)overflowBefore.push(stories[si].overflows);
        for(ti=0;ti<tables.length;ti++)tableLabels[tables[ti].label]=true;
        var allFrames=continuationFrames(d);
        for(var fi=0;fi<allFrames.length;fi++){
            var frame=allFrames[fi];
            frames.push(frame);frameIds[frame.id]=true;frameRecords.push({frame:frame,bounds:frame.geometricBounds.slice(0),base:frame.extractLabel('journal-continuation-base-top')});
        }
        // Backups preserve the exact old marker if a later recomposition fails.
        var items=d.allPageItems;
        for(var mi=0;mi<items.length;mi++){
            var match=String(items[mi].label).match(/^journal-continued-(source-table-[0-9]+)-([0-9]+)$/);
            if(!match||!tableLabels[match[1]]||!frameIds[Number(match[2])])continue;
            var oldMarker=items[mi],backup=oldMarker.duplicate(oldMarker.parentPage);
            backup.label='journal-continuation-rollback';backup.nonprinting=true;backup.parentStory.insertLabel('journal-role','');
            markers.push({item:oldMarker,backup:backup,label:oldMarker.label,nonprinting:oldMarker.nonprinting});
        }
        try{
            while(true){
                fragments=continuedTableFragments(d);var active={},changed=false,state=[];
                for(var i=0;i<fragments.length;i++)active[fragments[i].frame.id]=true;
                for(fi=0;fi<frames.length;fi++){
                    frame=frames[fi];var bounds=frame.geometricBounds,base=frame.extractLabel('journal-continuation-base-top');
                    if(active[frame.id]){
                        if(base===''){base=String(bounds[0]);frame.insertLabel('journal-continuation-base-top',base);}
                        var top=Number(base)+height+1;if(top>=bounds[2])throw Error('CONTINUATION_FRAME_CAPACITY');
                        if(Math.abs(bounds[0]-top)>.001){bounds[0]=top;frame.geometricBounds=bounds;changed=true;}
                    }else if(base!==''){
                        bounds[0]=Number(base);frame.geometricBounds=bounds;frame.insertLabel('journal-continuation-base-top','');changed=true;restored++;
                    }
                    state.push(frame.id+':'+frame.geometricBounds[0]+':'+(active[frame.id]?1:0));
                }
                if(!changed)break;
                var signature=state.join('|');if(seenStates[signature]||pass++>frames.length+1)throw Error('CONTINUATION_LAYOUT_UNSTABLE');
                seenStates[signature]=true;d.recompose();
            }
            var expected={};fragments=continuedTableFragments(d);
            for(i=0;i<fragments.length;i++){
                var spec=fragments[i],marker=null,count=0;expected[spec.key]=true;
                for(mi=0;mi<markers.length;mi++)if(markers[mi].label===spec.key){marker=markers[mi].item;count++;}
                if(count>1)throw Error('CONTINUATION_DUPLICATE '+spec.key);
                if(!marker){marker=template.duplicate(spec.frame.parentPage);created.push(marker);}
                marker.label=spec.key;marker.parentStory.insertLabel('journal-role','tableContinuation');
                if(marker.itemLayer&&(!marker.itemLayer.visible||!marker.itemLayer.printable))throw Error('CONTINUATION_MARKER_LAYER '+spec.key);
                marker.nonprinting=false;
                if(marker.parentPage.id!==spec.frame.parentPage.id)marker.move(spec.frame.parentPage);
                var fb=spec.frame.geometricBounds,baseTop=Number(spec.frame.extractLabel('journal-continuation-base-top'));
                marker.geometricBounds=[baseTop,fb[1],baseTop+height,fb[3]];
            }
            d.recompose();
            for(si=0;si<stories.length;si++)if(!overflowBefore[si]&&stories[si].overflows)throw Error('CONTINUATION_NEW_OVERSET');
            for(mi=0;mi<markers.length;mi++)if(!expected[markers[mi].label]){markers[mi].item.remove();removed++;}
            var issues=continuedTableIssues(d);if(issues.length)throw Error('CONTINUATION_INVALID '+issues.join(';'));
        }catch(error){
            for(i=0;i<created.length;i++)if(created[i].isValid)created[i].remove();
            for(fi=0;fi<frameRecords.length;fi++){var saved=frameRecords[fi];saved.frame.geometricBounds=saved.bounds;saved.frame.insertLabel('journal-continuation-base-top',saved.base);}
            for(mi=0;mi<markers.length;mi++){
                var record=markers[mi];
                if(record.item.isValid){
                    if(record.item.parentPage.id!==record.backup.parentPage.id)record.item.move(record.backup.parentPage);
                    record.item.geometricBounds=record.backup.geometricBounds;record.backup.remove();
                }else{
                    record.backup.label=record.label;record.backup.nonprinting=record.nonprinting;record.backup.parentStory.insertLabel('journal-role','tableContinuation');
                }
            }
            d.recompose();throw error;
        }
        for(mi=0;mi<markers.length;mi++)markers[mi].backup.remove();
        return {markers:fragments.length,removedMarkers:removed,restoredFrames:restored};
    }

    function continuedTableIssues(d){

        var fragments=continuedTableFragments(d),issues=[];

        for(var i=0;i<fragments.length;i++){

            var spec=fragments[i],matches=[],items=d.allPageItems;

            for(var j=0;j<items.length;j++)if(items[j].label===spec.key)matches.push(items[j]);

            if(matches.length!==1){issues.push(spec.key+' count='+matches.length);continue;}

            var marker=matches[0],mb=marker.geometricBounds,fb=spec.frame.geometricBounds,p=marker.paragraphs[0];

            if(meaningful(marker.contents)!=='（续表）'||Number(p.pointSize)!==9||Number(p.leading)!==12||marker.nonprinting||(marker.itemLayer&&(!marker.itemLayer.visible||!marker.itemLayer.printable))||marker.parentPage.id!==spec.frame.parentPage.id||Math.abs(mb[1]-fb[1])>.02||Math.abs(mb[3]-fb[3])>.02||Math.abs(fb[0]-mb[2]-1)>.02||marker.overflows)issues.push(spec.key+' format-or-position');

        }

        var expected={},labels={},frameIds={},tables=articleTables(d),all=d.allPageItems;
        for(i=0;i<fragments.length;i++)expected[fragments[i].key]=true;
        for(i=0;i<tables.length;i++)labels[tables[i].label]=true;
        var allFrames=continuationFrames(d);
        for(i=0;i<allFrames.length;i++)frameIds[allFrames[i].id]=true;
        for(i=0;i<all.length;i++){
            var match=String(all[i].label).match(/^journal-continued-(source-table-[0-9]+)-([0-9]+)$/);
            if(match&&labels[match[1]]&&frameIds[Number(match[2])]&&!expected[all[i].label])issues.push(all[i].label+' stale-marker');
        }
        var activeFrames={};for(i=0;i<fragments.length;i++)activeFrames[fragments[i].frame.id]=true;
        for(i=0;i<allFrames.length;i++){
            var frame=allFrames[i];
            if(frame.extractLabel('journal-continuation-base-top')!==''&&!activeFrames[frame.id])issues.push('frame '+frame.id+' stale-reserve');
        }
        return issues;

    }

    function setText(p,f,size,lead){p.appliedFont=font(f);p.pointSize=size;if(lead)p.leading=lead;}

    function applyFormulaStyles(d){var styles=d.allParagraphStyles,formulaStyle=null;for(var i=0;i<styles.length;i++)if(styles[i].name==='公式')formulaStyle=styles[i];var items=d.allPageItems;for(var i=0;i<items.length;i++)if(/^source-formula-/.test(items[i].label)&&items[i].extractLabel('formula-display')==='true'){if(!formulaStyle)throw Error('FORMULA_STYLE_MISSING');var p=items[i].parent.paragraphs[0];p.applyParagraphStyle(formulaStyle,true);p.appliedFont=font(R.bodyFont);p.pointSize=R.bodySize;p.leading=Math.max(Number(formulaStyle.leading),(items[i].geometricBounds[2]-items[i].geometricBounds[0]+1)*72/25.4);}}

    function fitFormulaNumbers(d){var items=d.allPageItems,logs=[];for(var i=0;i<items.length;i++)if(/^source-formula-/.test(items[i].label)&&items[i].extractLabel('formula-display')==='true'){

 var r=items[i],p=r.parent.paragraphs[0],frame=p.insertionPoints[0].parentTextFrames[0],target=frame.geometricBounds[1]+p.tabStops[0].position,text=String(p.contents),object=text.indexOf(String.fromCharCode(65532)),match=text.match(/[（(][0-9]+[）)]/);if(!match)throw Error('Formula number absent');

 var numberStart=text.indexOf(match[0]);if(p.lines.length===1&&r.extractLabel('formula-number-fit')==='spaces')continue;if(p.lines.length===1&&text.substring(object+1,numberStart).indexOf(String.fromCharCode(9))>=0)continue;

 var oldSpace=text.substring(object+1,numberStart),existing=oldSpace.length;

 p.characters.itemByRange(object+1,numberStart-1).contents=' ';d.recompose();p=r.parent.paragraphs[0];if(p.lines.length!==1)throw Error('Formula cannot share line '+r.label);

 var space=p.characters[object+1];space.horizontalScale=100;var advance=space.endHorizontalOffset-space.horizontalOffset;if(advance<=0)throw Error('Space has no width');

 var center=(r.geometricBounds[1]+r.geometricBounds[3])/2,needed=advance+center-target;if(needed<=0)throw Error('Number cannot fit at original center');

 var count=Math.ceil(needed/advance);if(existing===count&&oldSpace.indexOf(String.fromCharCode(9))<0)count=existing;

 space.contents=Array(count+1).join(' ');p=r.parent.paragraphs[0];for(var k=0;k<count;k++)p.characters[object+1+k].horizontalScale=100;

 var tail=p.characters[object+count],scale=(needed-(count-1)*advance)/advance*100;tail.horizontalScale=scale;d.recompose();

 for(var pass=0;pass<3;pass++){var error=(r.geometricBounds[1]+r.geometricBounds[3])/2-target;if(Math.abs(error)<.005)break;scale+=error/advance*100;tail.horizontalScale=scale;d.recompose();}

 var error=(r.geometricBounds[1]+r.geometricBounds[3])/2-target;if(Math.abs(error)>.02||p.lines.length!==1)throw Error('Fit did not preserve center '+r.label+' error '+error);

 r.insertLabel('formula-number-fit','spaces');r.insertLabel('formula-center-mm',String(target-frame.geometricBounds[1]));

 logs.push(r.label+' spaces '+count+' lastSpaceScale '+scale+' centerErrorMM '+error+' lines '+p.lines.length);

 var guides=frame.parentPage.guides,found=false;for(var gi=0;gi<guides.length;gi++)if(guides[gi].label==='formula-center-guide')found=true;if(!found){var guide=guides.add({orientation:HorizontalOrVertical.VERTICAL,location:target});guide.label='formula-center-guide';}

}

return logs;}



    function numericText(r){var t=String(r.contents),digit=false;for(var i=0;i<t.length;i++){var code=t.charCodeAt(i);if(code>=48&&code<=57)digit=true;else if(code>32)return false;}return digit;}

    function digitRole(r){return r==='body'||r==='reference'||r==='english'||r==='cnAffiliation'||r==='enAffiliation'||r==='enAuthor'||r==='formula';}

    var timesFaces=null;

    function timesFont(face){if(!timesFaces){timesFaces={};var fonts=app.fonts.everyItem().getElements(),posts={'TimesNewRomanPSMT':'Regular','TimesNewRomanPS-ItalicMT':'Italic','TimesNewRomanPS-BoldMT':'Bold','TimesNewRomanPS-BoldItalicMT':'Bold Italic'};for(var i=0;i<fonts.length;i++)if(String(fonts[i].fontFamily)==='Times New Roman'&&fonts[i].status===FontStatus.INSTALLED&&posts[String(fonts[i].postscriptName)])timesFaces[posts[String(fonts[i].postscriptName)]]=fonts[i];}if(!timesFaces[face])throw Error('TIMES_FACE_UNAVAILABLE '+face);return timesFaces[face];}

    function applyDigits(text){var chars=text.characters.everyItem().getElements();for(var i=0;i<chars.length;i++)if(/^[0-9]$/.test(String(chars[i].contents))){var face=String(chars[i].fontStyle),target=/Bold/.test(face)?(/Italic/.test(face)?'Bold Italic':'Bold'):(/Italic/.test(face)?'Italic':'Regular');var tf=timesFont(target);chars[i].properties={appliedFont:tf,fontStyle:target};// Verify via the font object's fontFamily, not through the composite alias in appliedFont.name.
var actualFontFamily='';try{actualFontFamily=String(chars[i].appliedFont.fontFamily);}catch(e){}if(actualFontFamily!=='Times New Roman')throw Error('DIGIT_FONT_ASSIGNMENT '+chars[i].index+' fontFamily='+actualFontFamily);}}

    function specialGlyphFont(character){var text=String(character);if(text==='＞'||text==='＜')return '黑体';return text==='､'?'思源宋体 CN':null;}

    function specialGlyphRangeFontAllowed(text,actual){var value=meaningful(text);if(!value)return false;for(var i=0;i<value.length;i++)if(specialGlyphFont(value.charAt(i))!==actual)return false;return true;}

    function glyphFontIssue(character,actual){var expected=specialGlyphFont(character);return expected&&expected!==actual?expected:null;}

    function applySpecialGlyphs(text){var chars=text.characters.everyItem().getElements();for(var i=0;i<chars.length;i++){var target=specialGlyphFont(chars[i].contents);if(target)chars[i].properties={appliedFont:font(target),fontStyle:'Regular'};}}

    function finishTypography(d){var a=scope(d);for(var k=0;k<a.length;k++)for(var i=0;i<a[k].paragraphs.length;i++){var p=a[k].paragraphs[i];var pr=role(p,a[k].extractLabel('journal-role'));if(digitRole(pr))applyDigits(p);applySpecialGlyphs(p);if(pr==='body'||pr==='formula'){var chars=p.characters.everyItem().getElements();for(var ci=0;ci<chars.length;ci++)if(chars[ci].contents==='≤'||chars[ci].contents==='≥')chars[ci].properties={appliedFont:font('宋体'),fontStyle:'Regular'};}}var tables=articleTables(d);for(var i=0;i<tables.length;i++)for(var j=0;j<tables[i].cells.length;j++){applyDigits(tables[i].cells[j].texts[0]);applySpecialGlyphs(tables[i].cells[j].texts[0]);}}

    function protectedTokens(p){

        var text=String(p.contents),tokens=[],patterns=[/[A-Za-z0-9]+[ ]*[≤≥<>][ ]*[-−]?[A-Za-z0-9]+(?:[.][0-9]+)?/g,/\[[0-9]+(?:[-–—,，][0-9]+)*\]/g,/[0-9]+(?:[.,][0-9]+)*(?: [0-9]{3})*(?:×10[-−]?[0-9]+)?(?:[ \u00a0]*(?:kg|mg|mm|cm|km|ms|MHz|GHz|Hz|mH|mW|kW|Wb|r\/min|rad\/s|min|s|m|A|V|W|N|H|Ω|℃|%)(?:[·\/][A-Za-z0-9²³]+)*)?/g];

        for(var i=0;i<patterns.length;i++){var match;while((match=patterns[i].exec(text))!==null){var start=match.index;if(i===1&&start>0){var previous=start-1;while(previous>=0&&/\s/.test(text.charAt(previous)))previous--;if(previous>=0)start=previous;}tokens.push({start:start,end:match.index+match[0].length-1,text:match[0]});}}

        return tokens;

    }

    function sourcePosition(value){if(value==='subscript')return Position.SUBSCRIPT;if(value==='superscript')return Position.SUPERSCRIPT;return Position.NORMAL;}

    function mergeExpectedSpan(merge){var expected=merge.expectedRowSpan===undefined?2:Number(merge.expectedRowSpan);if(expected<2||expected!==Math.floor(expected)||merge.intoRow>=merge.rowIndex||merge.rowIndex-merge.intoRow>=expected)throw Error('MERGE_SPAN_CONFIG');return expected;}
    function sourceTableCell(tables,c,run){
        var index=run.cellIndex,merges=c.mergedEmptyCells||[];
        for(var i=0;i<merges.length;i++){var m=merges[i];if(m.tableIndex!==run.tableIndex||m.rowIndex!==run.rowIndex||m.cellIndex>=run.cellIndex)continue;
            mergeExpectedSpan(m);var anchor=sourceTableCell(tables,c,{tableIndex:m.tableIndex,rowIndex:m.intoRow,cellIndex:m.intoCell});
            if(anchor.rowSpan>m.rowIndex-m.intoRow)index--;
        }
        return tables[run.tableIndex].rows[run.rowIndex].cells[index];
    }
    function applySourceMerges(tables,c){
        var merges=c&&c.mergedEmptyCells||[];
        for(var i=0;i<merges.length;i++){var m=merges[i],expected=mergeExpectedSpan(m),dest=sourceTableCell(tables,c,{tableIndex:m.tableIndex,rowIndex:m.intoRow,cellIndex:m.intoCell});
            if(dest.rowSpan>expected)throw Error('MERGE_UNEXPECTED_SPAN');
            if(dest.rowSpan>m.rowIndex-m.intoRow)continue;
            var empty=sourceTableCell(tables,c,m);if(meaningful(empty.contents))throw Error('MERGE_NONEMPTY_CELL');dest.merge(empty);
        }
        for(var j=0;j<merges.length;j++){var merge=merges[j],cell=sourceTableCell(tables,c,{tableIndex:merge.tableIndex,rowIndex:merge.intoRow,cellIndex:merge.intoCell});if(cell.rowSpan!==mergeExpectedSpan(merge))throw Error('MERGE_INCOMPLETE_SPAN');}
    }

    function sourceTableCharacterMatches(text,index,expected,position,italic){var character=text.characters[index];return String(text.characters.itemByRange(index,index).contents)===expected&&character.position===position&&(/Italic/.test(String(character.fontStyle)))===italic;}

    function applySourceTableFormatting(d,c){

        if(!c||!c.tableTextRuns)return;var tables=articleTables(d);

        for(var i=0;i<c.tableTextRuns.length;i++){var run=c.tableTextRuns[i],cell=sourceTableCell(tables,c,run),text=cell.texts[0],end=run.start+run.text.length-1;

            if(String(text.characters.itemByRange(run.start,end).contents)!==run.text)throw Error('SOURCE_TABLE_RUN_TEXT '+i);

            var range=text.characters.itemByRange(run.start,end);range.position=sourcePosition(run.position);

            if(/^[A-Za-z0-9 \u00a0.,;:+\-]+$/.test(run.text))range.properties={appliedFont:timesFont(run.italic?'Italic':'Regular'),fontStyle:run.italic?'Italic':'Regular'};

            else if(run.italic)throw Error('SOURCE_TABLE_ITALIC_REQUIRES_FONT '+i);if(/^[A-Za-z0-9]+$/.test(run.text)&&family(cell.texts[0].characters[run.start])!=='Times New Roman')throw Error('SOURCE_TABLE_FONT_ALIAS '+i+' '+family(cell.texts[0].characters[run.start]));

        }

    }









    function captionGapContract(c){
        if(R.captionGap!==5||(c&&c.figureCaptionGapPt!==undefined&&c.figureCaptionGapPt!==5))throw Error('FIGURE_CAPTION_GAP_CONTRACT expected=5pt');
        return R.captionGap;
    }

    function inlineCaptionSpacing(d,apply){
        var errors=[],stories=scope(d),required=captionGapContract(),changed=false;
        for(var si=0;si<stories.length;si++){
            var story=stories[si],storyRole=story.extractLabel('journal-role');
            if(storyRole!=='body'&&storyRole!=='figures'&&storyRole!=='captions'&&storyRole!=='figureCaption')continue;
            for(var pi=2;pi<story.paragraphs.length;pi++){
                var p=story.paragraphs[pi],text=String(p.contents);
                if(role(p,storyRole)!=='caption'||!/^\s*(?:图\s*[0-9]+\s|[（(][a-zA-Z][）)])/.test(text))continue;
                var gap=story.paragraphs[pi-1],anchor=story.paragraphs[pi-2];
                if(meaningful(gap.contents)||meaningful(anchor.contents)||gap.tables.length||anchor.tables.length||gap.allPageItems.length)continue;
                var objects=anchor.allPageItems,image=false;
                for(var oi=0;oi<objects.length;oi++){
                    var object=objects[oi];
                    if(/^source-formula-/.test(String(object.label)))continue;
                    if(object.parent.constructor.name==='Character'&&object.allGraphics&&object.allGraphics.length){image=true;break;}
                }
                if(!image)continue;
                var actual=Number(gap.leading),extra=Number(anchor.spaceAfter)+Number(gap.spaceBefore)+Number(gap.spaceAfter)+Number(p.spaceBefore);
                if(!isFinite(actual)||Math.abs(actual-required)>.001||!isFinite(extra)||Math.abs(extra)>.001){
                    if(apply){gap.leading=required;anchor.spaceAfter=0;gap.spaceBefore=0;gap.spaceAfter=0;p.spaceBefore=0;changed=true;}
                    else errors.push(story.id+'/'+pi+' actual='+actual+' expected='+required+' additiveSpacing='+extra);
                }
            }
        }
        if(changed)d.recompose();
        return errors;
    }

    function separateCaptionSpacing(d,apply){

        var result=[],stories=scope(d),items=d.allPageItems;

        for(var si=0;si<stories.length;si++){

            var story=stories[si],r=story.extractLabel('journal-role');if(r!=='captions'&&r!=='figureCaption'&&r!=='figures')continue;

            var match=String(story.contents).match(/图([0-9]+)\s/);if(!match||!story.lines.length)continue;

            var frame=story.textContainers[0],bottom=-Infinity,owned=false;

            for(var oi=0;oi<items.length;oi++)if(new RegExp('^source-figure-'+match[1]+'[a-z]?$').test(items[oi].label)){

                var object=items[oi];if(object.parent.constructor.name==='Character'&&object.parent.parentStory.id===story.id){owned=true;break;}

                if(object.parentPage&&frame.parentPage&&object.parentPage.id===frame.parentPage.id)bottom=Math.max(bottom,object.geometricBounds[2]);

            }

            if(owned||bottom===-Infinity)continue;

            var gap=(inkBounds(story.lines[0])[0]-bottom)*72/25.4;

            if(apply){

                var dy=(R.captionGap-gap)*25.4/72,b=frame.geometricBounds,oldBottom=b[2];frame.geometricBounds=[b[0]+dy,b[1],b[2]+dy,b[3]];

                var bodyFrames=one(d,'body').textContainers;

                for(var fi=0;fi<bodyFrames.length;fi++)if(bodyFrames[fi].parentPage.id===frame.parentPage.id&&bodyFrames[fi].geometricBounds[0]>=oldBottom-.02){var fb=bodyFrames[fi].geometricBounds;fb[0]+=dy;bodyFrames[fi].geometricBounds=fb;}

                d.recompose();gap=(inkBounds(story.lines[0])[0]-bottom)*72/25.4;

            }

            result.push({number:match[1],gap:gap});

        }

        return result;

    }

    function normalizeTableCaption(p,apply){

        var text=String(p.contents),unit=text.match(/\s+(单位\s*[:：].+?)\r?$/);if(!unit)return null;

        var title=text.substring(0,unit.index).replace(/\s+$/,'');

        if(apply){

            p.contents='\t'+title+'\t'+unit[1]+'\r';p.justification=Justification.LEFT_ALIGN;p.firstLineIndent=0;p.leftIndent=0;p.rightIndent=0;

            var owners=p.insertionPoints[0].parentTextFrames;if(!owners.length)throw Error('TABLE_CAPTION_FRAME');var b=owners[0].geometricBounds,w=b[3]-b[1];

            while(p.tabStops.length)p.tabStops[0].remove();p.tabStops.add({position:w/2,alignment:TabStopAlignment.CENTER_ALIGN});p.tabStops.add({position:w,alignment:TabStopAlignment.RIGHT_ALIGN});

        }

        return {title:title,unit:unit[1]};

    }

    function removableHeadingBlank(text,leading,hasTable,hasItems,followingRole){

        if(meaningful(text)||hasTable||hasItems||Number(leading)<14.8)return false;

        if(followingRole==='h1'||followingRole==='h2')return true;return false;

    }

    function normalizeStructuralSpacing(d){

        var body=one(d,'body');

        for(var i=body.paragraphs.length-1;i>=0;i--){

            var p=body.paragraphs[i],t=String(p.contents);

            if(p.tables.length){p.pointSize=1;p.leading=1;p.spaceBefore=0;p.spaceAfter=0;}

            if(/^表\d+\s/.test(t)){normalizeTableCaption(p,true);p.spaceBefore=0;p.spaceAfter=0;}

            if(i+1<body.paragraphs.length){

                var next=body.paragraphs[i+1],r=role(next,'body');if(removableHeadingBlank(t,p.leading,p.tables.length,p.allPageItems.length,r))p.remove();

            }

        }

        d.recompose();

    }

    function formulaLineSpacing(d,apply){

        var errors=[],items=d.allPageItems,seen={},changes=[];

        for(var oi=0;oi<items.length;oi++){

            var object=items[oi];if(!/^source-formula-/.test(object.label)||object.parent.constructor.name!=='Character')continue;

            if(object.extractLabel('formula-display')==='false'){

                var inlineBounds=object.geometricBounds,inlineMinimum=Math.max(15,(inlineBounds[2]-inlineBounds[0])*72/25.4+2),inlineCurrent=Number(object.parent.leading);

                if(inlineCurrent<inlineMinimum-.01){if(apply)object.parent.leading=inlineMinimum;else errors.push('FORMULA_INLINE_LEADING '+object.label);}

                continue;

            }

            var p=object.parent.paragraphs[0],key=object.parent.parentStory.id+':'+p.index;

            if(seen[key]||String(p.contents).replace(/[\s\uFFFC，,0-9（）()]/g,''))continue;seen[key]=true;

            for(var li=0;li<p.lines.length;li++){

                var line=p.lines[li],start=line.characters[0].index,end=line.characters[-1].index,height=0;

                for(var ni=0;ni<items.length;ni++){

                    var nativeItem=items[ni];if(!/^source-formula-/.test(nativeItem.label)||nativeItem.parent.constructor.name!=='Character'||nativeItem.parent.parentStory.id!==object.parent.parentStory.id)continue;

                    if(nativeItem.parent.index>=start&&nativeItem.parent.index<=end){var bounds=nativeItem.geometricBounds;height=Math.max(height,bounds[2]-bounds[0]);}

                }

                if(!height)continue;var desired=Math.max(15,height*72/25.4+2),maximum=Math.max(15,(height+1)*72/25.4),current=Number(line.characters[-1].leading),target=current;

                if(p.lines.length>1)target=desired;else if(current<desired-.01)target=desired;else if(current>maximum+.01)target=maximum;

                var lineMismatch=false;for(var lci=0;lci<line.characters.length;lci++)if(Math.abs(Number(line.characters[lci].leading)-target)>.01)lineMismatch=true;
                if(apply&&lineMismatch)changes.push({line:line,leading:target});else if(!apply&&lineMismatch)errors.push('FORMULA_LINE_LEADING '+key+'/'+li);

            }

        }

        for(var ci=0;ci<changes.length;ci++)changes[ci].line.characters.everyItem().leading=changes[ci].leading;

        if(changes.length)d.recompose();return errors;

    }

    function formulaPadding(d,apply){

        var errors=[],items=d.allPageItems;

        for(var i=0;i<items.length;i++)if(items[i].label==='formula-layout-padding'){

            var item=items[i].getElements()[0];

            if(apply){item.applyObjectStyle(d.objectStyles[0],true,true);item.properties={fillColor:d.swatches.itemByName('None'),strokeColor:d.swatches.itemByName('None'),strokeWeight:0};}

            if(item.fillColor.name!=='None'||item.strokeColor.name!=='None')errors.push('FORMULA_PADDING_VISIBLE '+item.id);

        }

        return errors;

    }

    function formulaPlacementAllowed(asset, config){if(asset.kind!=='formula')return true;if(asset.placement==='native-vector')return true;if(config&&config.legacyRegressionFixture===true)return true;return false;}

    function formulaCacheIssues(d,c){
        var specs=c&&c.formulaCacheContract,errors=[];if(!specs)return errors;
        var fields=[['cacheKey','formula-cache-key'],['sha256','formula-idms-sha256'],['sourceSha256','formula-source-sha256'],['ruleVersion','formula-rule-version']];
        for(var si=0;si<specs.length;si++){
            var spec=specs[si],found=0,items=d.allPageItems;
            for(var oi=0;oi<items.length;oi++){
                var item=items[oi];if(item.label!=='source-formula-'+spec.number)continue;found++;
                for(var fi=0;fi<fields.length;fi++){
                    var expected=spec[fields[fi][0]],actual=item.extractLabel(fields[fi][1]);
                    if(!expected||String(actual).toLowerCase()!==String(expected).toLowerCase())errors.push(spec.number+' '+fields[fi][1]+' expected='+expected+' actual='+actual);
                }
            }
            if(found!==1)errors.push(spec.number+' COUNT '+found);
        }
        return errors;
    }

    function sourceFormulaNumbering(d,c,apply){

        var errors=[],specs=c&&c.formulaNumbers;if(!specs)return errors;

        for(var si=0;si<specs.length;si++){

            var spec=specs[si],items=d.allPageItems,found=0;

            for(var oi=0;oi<items.length;oi++){

                var item=items[oi];if(item.label!=='source-formula-'+spec.number||item.parent.constructor.name!=='Character')continue;

                found++;var p=item.parent.paragraphs[0],text=String(p.contents),printed=text.match(/[（(]([0-9]+)[）)]/);

                if(spec.inline===true){

                    if(spec.displayNumber!==null&&spec.displayNumber!==undefined){errors.push('SOURCE_INLINE_FORMULA_NUMBER '+spec.number);continue;}

                    if(apply){
                        item.insertLabel('formula-display','false');item.insertLabel('formula-printed-number','');item.insertLabel('formula-inline','true');
                        if(p.appliedParagraphStyle&&String(p.appliedParagraphStyle.name).replace(/^journal-[^:]+::/,'')==='公式'){
                            var bodyStyles=[],allStyles=d.allParagraphStyles;
                            for(var bsi=0;bsi<allStyles.length;bsi++)if(String(allStyles[bsi].name).replace(/^journal-[^:]+::/,'')==='正文_wrd_1')bodyStyles.push(allStyles[bsi]);
                            if(bodyStyles.length!==1)throw Error('SOURCE_INLINE_BODY_STYLE_COUNT '+bodyStyles.length);
                            var bodyStyle=bodyStyles[0];p.applyParagraphStyle(bodyStyle,false);p.pointSize=R.bodySize;p.leading=15;
                            var restoredProperties=['firstLineIndent','leftIndent','rightIndent','justification','spaceBefore','spaceAfter'];
                            for(var rpi=0;rpi<restoredProperties.length;rpi++)p[restoredProperties[rpi]]=bodyStyle[restoredProperties[rpi]];
                        }
                    }

                    else if(item.extractLabel('formula-display')!=='false'||item.extractLabel('formula-printed-number')!=='')errors.push('SOURCE_INLINE_FORMULA_DISPLAY '+spec.number);

                    continue;

                }

                if(spec.displayNumber===null){

                    if(String(text).replace(/[\s\uFFFC（）()0-9]/g,'')){errors.push('SOURCE_FORMULA_NOT_STANDALONE '+spec.number);continue;}

                    if(apply){

                        for(var ci=p.characters.length-2;ci>=0;ci--)if(String(p.characters[ci].contents)!=='\uFFFC')p.characters[ci].remove();

                        p.justification=Justification.CENTER_ALIGN;p.firstLineIndent=0;p.leftIndent=0;p.rightIndent=0;item.insertLabel('formula-display','unnumbered');

                    }else{if(printed)errors.push('SOURCE_FORMULA_NUMBER '+spec.number+' unexpected '+printed[1]);if(p.justification!==Justification.CENTER_ALIGN||item.extractLabel('formula-display')!=='unnumbered')errors.push('SOURCE_FORMULA_CENTER '+spec.number);}

                }else if(!printed||String(printed[1])!==String(spec.displayNumber))errors.push('SOURCE_FORMULA_NUMBER '+spec.number);

                else if(apply){item.insertLabel('formula-display','true');item.insertLabel('formula-printed-number',String(spec.displayNumber));}

                else if(item.extractLabel('formula-display')!=='true')errors.push('SOURCE_FORMULA_DISPLAY '+spec.number);

            }

            if(found!==1)errors.push('SOURCE_FORMULA_COUNT '+spec.number+' '+found);

        }

        return errors;

    }

    function sourceProjection(text){

        text=String(text);var value='',offsets=[],token=/⟦EQ-\d+⟧|\{\{(?:FORMULA|EQ)[^}]*\}\}/g,skip={},match;

        while((match=token.exec(text)))for(var z=match.index;z<match.index+match[0].length;z++)skip[z]=true;

        for(var i=0;i<text.length;i++)if(!skip[i]&&!/[\s\uFFFC\u0016]/.test(text.charAt(i))){value+=text.charAt(i);offsets.push(i);}

        return {text:value,offsets:offsets};

    }

    function sourceTextFormatting(d,c,apply){

        var errors=[],blocks=c&&c.sourceTextFormatting,stories=scope(d);if(!blocks)return errors;

        for(var bi=0;bi<blocks.length;bi++){

            var block=blocks[bi];if(block.role==='formula'||block.role==='math')continue;

            var src=sourceProjection(block.text);if(!src.text||/^[（(][0-9]+[）)]$/.test(src.text)||/^[，,;；:：]+$/.test(src.text))continue;

            var matches=[];

            for(var si=0;si<stories.length;si++)for(var pi=0;pi<stories[si].paragraphs.length;pi++){

                var paragraph=stories[si].paragraphs[pi],r=role(paragraph,stories[si].extractLabel('journal-role'));

                if(r!=='body'&&r!=='h1'&&r!=='h2'&&r!=='caption'&&r!=='reference'&&r!=='referenceTitle'&&r!=='bio')continue;

                var actual=sourceProjection(paragraph.contents);if(actual.text===src.text)matches.push({paragraph:paragraph,projection:actual});

            }

            if(matches.length!==1){errors.push('SOURCE_TEXT_FORMAT_COUNT '+bi+' '+matches.length);continue;}

            var hit=matches[0],runs=block.runs||[];

            for(var ci=0;ci<src.offsets.length;ci++){

                var italic=false,position=Position.NORMAL;

                for(var ri=0;ri<runs.length;ri++)if(src.offsets[ci]>=runs[ri].start&&src.offsets[ci]<runs[ri].end){

                    if(runs[ri].italic===true)italic=true;

                    if(runs[ri].position)position=sourcePosition(runs[ri].position);

                }

                var exceptionFont=null,exceptions=c.sourceFormatExceptions||[];
                for(var exi=0;exi<exceptions.length;exi++){
                    var ex=exceptions[exi];
                    if(ex.userApproved!==true||!ex.reason||ex.role!==block.role||ex.paragraphText!==block.text||String(block.text).substring(ex.start,ex.end)!==ex.text||src.offsets[ci]<ex.start||src.offsets[ci]>=ex.end)continue;
                    if(typeof ex.italic==='boolean')italic=ex.italic;
                    if(ex.fontFamily)exceptionFont=ex.fontFamily;
                }
                var ch=hit.paragraph.characters[hit.projection.offsets[ci]],actualItalic=/Italic|Oblique/.test(String(ch.fontStyle));

                if(apply){

                    ch.position=position;

                    if(italic){ch.appliedFont=timesFont('Italic');ch.fontStyle='Italic';}

                    else if(actualItalic){if(family(ch)==='Times New Roman'){ch.appliedFont=timesFont('Regular');ch.fontStyle='Regular';}else{ch.appliedFont=hit.paragraph.appliedParagraphStyle.appliedFont;ch.fontStyle=hit.paragraph.appliedParagraphStyle.fontStyle;}}

                }

                if(exceptionFont){
                    if(apply){ch.appliedFont=font(exceptionFont+String.fromCharCode(9)+'Regular');ch.fontStyle='Regular';}
                    if(family(ch)!==exceptionFont||String(ch.fontStyle)!=='Regular')errors.push('SOURCE_EXCEPTION_FONT '+bi+':'+src.offsets[ci]);
                }

                if(ch.position!==position)errors.push('SOURCE_TEXT_POSITION '+bi+':'+src.offsets[ci]);

                if(italic!==/Italic|Oblique/.test(String(ch.fontStyle)))errors.push('SOURCE_TEXT_ITALIC '+bi+':'+src.offsets[ci]+' '+String(ch.contents));

            }

        }

        return errors;

    }

    function forbiddenLineStart(text){return /^[，。、；：！？）】》〉」』〕〗〙〛,.!?;:)]/.test(String(text).replace(/^[\s]+/,''));}

    function protectLineTokens(d){var stories=scope(d);for(var si=0;si<stories.length;si++)for(var pi=0;pi<stories[si].paragraphs.length;pi++){var p=stories[si].paragraphs[pi],r=role(p,stories[si].extractLabel('journal-role'));if(r!=='body'&&r!=='formula'&&r!=='fund')continue;var tokens=protectedTokens(p);for(var i=0;i<tokens.length;i++)if(tokens[i].end>tokens[i].start)p.characters.itemByRange(tokens[i].start,tokens[i].end).noBreak=true;if(r==='formula'){var chars=p.characters.everyItem().getElements();for(var ci=0;ci<chars.length;ci++)if(chars[ci].contents===SpecialCharacters.ELLIPSIS_CHARACTER||chars[ci].contents==='…'||chars[ci].contents==='⋯'){chars[ci].contents='⋯';chars[ci].properties={appliedFont:font('Cambria Math'),pointSize:10.5};}}}d.recompose();}

    function normalizeDigitFonts(d){
        var stories=scope(d),count=0;
        for(var si=0;si<stories.length;si++)for(var pi=0;pi<stories[si].paragraphs.length;pi++){
            var p=stories[si].paragraphs[pi];
            if(!digitRole(role(p,stories[si].extractLabel('journal-role'))))continue;
            applyDigits(p);count++;
        }
        return count;
    }

    function applyEnglishAffiliationSpacing(p){var base=Number(p.appliedParagraphStyle.leading);if(base!==25)throw Error('EN_AFFILIATION_STYLE_CONTRACT '+base);p.leading=base;for(var i=0;i+1<p.lines.length;i++)p.lines[i].characters.everyItem().leading=15;}

    function bodyIndentation(d,apply){
        var errors=[],stories=scope(d);
        for(var si=0;si<stories.length;si++)for(var pi=0;pi<stories[si].paragraphs.length;pi++){
            var p=stories[si].paragraphs[pi],text=String(p.contents);
            if(role(p,stories[si].extractLabel('journal-role'))!=='body'||!meaningful(text)||p.tables.length||/^\s*(?:图|表)\s*[0-9]+\s/.test(text))continue;
            var expected=Number(p.appliedParagraphStyle.firstLineIndent),actual=Number(p.firstLineIndent),where=stories[si].id+'/'+pi;
            if(!isFinite(expected)||expected<=0){errors.push(where+' BODY_INDENT_TEMPLATE');continue;}
            if(!isFinite(actual)||Math.abs(actual-expected)>.001){
                if(apply)p.firstLineIndent=p.appliedParagraphStyle.firstLineIndent;
                else errors.push(where+' actual='+actual+' expected='+expected);
            }
        }
        return errors;
    }

    function applyTypography(d,config){

        captionGapContract(config);



        applyFormulaStyles(d);

        var a=scope(d);

        for(var k=0;k<a.length;k++)for(var i=0;i<a[k].paragraphs.length;i++){

            var p=a[k].paragraphs[i],t=String(p.contents),r=role(p,a[k].extractLabel('journal-role'));

            if(r==='fund'){p.justification=Justification.LEFT_JUSTIFIED;

            }else if(r==='english'){

                if(t.indexOf('Absrtact:')===0)p.characters.itemByRange(0,7).contents='Abstract';

                setText(p,R.bodyFont,9,13);var colon=String(p.contents).indexOf(':');

                if(colon<0)throw Error('ENGLISH_LABEL');p.characters.itemByRange(0,colon).appliedFont=font('思源黑体 CN\tBold');

            }else if(r==='enAffiliation'){

                applyEnglishAffiliationSpacing(p);

            }else if(r==='enTitle'){

                if(p.lines.length)p.lines[-1].characters.everyItem().leading=p.appliedParagraphStyle.leading;p.spaceBefore=p.appliedParagraphStyle.spaceBefore;p.spaceAfter=p.appliedParagraphStyle.spaceAfter;

            }else if(r==='bio'){

                setText(p,'楷体',9,13);p.spaceBefore=0;p.spaceAfter=0;var end=t.indexOf('：');if(end<0)end=t.indexOf(':');if(end<0)throw Error('BIO_LABEL');

                var label=p.characters.itemByRange(0,end);applyBiographyLabelStyle(d,label);label.appliedFont=font('现 黑体');label.pointSize=12;label.leading=16;

            }else if(r==='h2'){p.keepWithNext=1;p.keepLinesTogether=true;p.keepAllLinesTogether=true;

            }else if(r==='referenceTitle'){p.keepWithNext=1;

            }else if(r==='reference'){p.keepLinesTogether=true;p.keepAllLinesTogether=false;p.keepFirstLines=1;p.keepLastLines=1;

            }else if(r==='body'){

                var ranges=p.textStyleRanges.everyItem().getElements(),fix=[];

                for(var j=0;j<ranges.length;j++)if(meaningful(ranges[j].contents)&&family(ranges[j])!==R.bodyFont&&family(ranges[j])!=='Times New Roman'&&family(ranges[j])!=='Cambria Math'&&family(ranges[j])!=='Symbol'&&family(ranges[j])!=='黑体'&&!(family(ranges[j])==='宋体'&&/^[≤≥]+$/.test(meaningful(ranges[j].contents))))fix.push([ranges[j].characters[0].index,ranges[j].characters[-1].index]);

                for(var j=0;j<fix.length;j++)a[k].characters.itemByRange(fix[j][0],fix[j][1]).appliedFont=font(R.bodyFont);

                p.pointSize=R.bodySize;p.leading=15;

                if(p.justification===Justification.RIGHT_ALIGN)p.justification=Justification.LEFT_JUSTIFIED;

            }

        }

        var tables=articleTables(d);applySourceMerges(tables,config);for(var i=0;i<tables.length;i++){

            var table=tables[i],headerCount=config&&config.tableHeaderRows&&config.tableHeaderRows[i]||1;

            if(headerCount<1||headerCount>=table.rows.length||headerCount!==Math.floor(headerCount))throw Error('TABLE_HEADER_CONFIG '+i);

            if(table.headerRowCount>headerCount)throw Error('TABLE_HEADER_STRUCTURE '+i);

            for(var h=0;h<headerCount;h++)if(table.rows[h].rowType!==RowTypes.HEADER_ROW)table.rows[h].rowType=RowTypes.HEADER_ROW;

            for(var c=0;c<table.cells.length;c++)setText(table.cells[c].texts[0],R.bodyFont,9,12);

            for(var j=0;j<table.rows.length;j++){var row=table.rows[j],multi=false;for(var rc=0;rc<row.cells.length;rc++)if(row.cells[rc].texts[0].lines.length>1)multi=true;row.autoGrow=true;row.minimumHeight=Math.max(4.8,multi?Number(row.minimumHeight):Math.min(5.5,Number(row.minimumHeight)));}

            for(var hr=0;hr<table.headerRowCount;hr++)for(var hc=0;hc<table.rows[hr].cells.length;hc++){var cell=table.rows[hr].cells[hc],text=String(cell.contents);if(text.length===7&&text.substr(1)==='号无人机路径')cell.insertionPoints[5].contents=SpecialCharacters.FORCED_LINE_BREAK;}

        }

        if(config&&config.widePanelBoundaries)for(var wi=0;wi<config.widePanelBoundaries.length;wi++)for(var pi=0;pi<one(d,'body').paragraphs.length;pi++){var p=one(d,'body').paragraphs[pi];if(meaningful(p.contents)===meaningful(config.widePanelBoundaries[wi].paragraphText)&&config.widePanelBoundaries[wi].keepAllLinesTogether===true){p.keepLinesTogether=true;p.keepAllLinesTogether=true;}}

        normalizeStructuralSpacing(d);formulaPadding(d,true);separateCaptionSpacing(d,true);finishTypography(d);applySourceTableFormatting(d,config);sourceTextFormatting(d,config,true);sourceFormulaNumbering(d,config,true);protectLineTokens(d);formulaLineSpacing(d,true);bodyIndentation(d,true);inlineCaptionSpacing(d,true);

    }

    function inkBounds(line){var shapes=line.createOutlines(false),bounds=[1e9,1e9,-1e9,-1e9];try{for(var i=0;i<shapes.length;i++){var b=shapes[i].geometricBounds;bounds=[Math.min(bounds[0],b[0]),Math.min(bounds[1],b[1]),Math.max(bounds[2],b[2]),Math.max(bounds[3],b[3])];}}finally{for(var i=0;i<shapes.length;i++)if(shapes[i].isValid)shapes[i].remove();}if(bounds[0]===1e9)throw Error('INK_BOUNDS_EMPTY');return bounds;}

    function receivedSeparatorY(baseline,c){
        if(!c||typeof c.receivedSeparatorBaselineGapMm!=='number'||c.receivedSeparatorBaselineGapMm<=0)throw Error('RECEIVED_SEPARATOR_CONTRACT');
        return Number(baseline)-c.receivedSeparatorBaselineGapMm;
    }
    function applyBiographyLabelStyle(d,range){
        var direct=d.characterStyles.itemByName('12磅黑体'),found=[];
        if(direct.isValid!==false){range.applyCharacterStyle(direct,false);return;}
        var styles=d.allCharacterStyles;for(var i=0;i<styles.length;i++)if(styles[i].name==='12磅黑体')found.push(styles[i]);
        if(found.length!==1)throw Error('BIO_CHARACTER_STYLE_COUNT '+found.length);
        range.applyCharacterStyle(found[0],false);
    }
    function repairTemplateDetails(d,c){
        if(!c.doiContract||!c.doiContract.text)throw Error('DOI_TEMPLATE_CONTRACT');
        function bound(role){if(c.bindings&&c.bindings.length){for(var bi=0;bi<c.bindings.length;bi++)if(c.bindings[bi].role===role)return d.stories.itemByID(c.bindings[bi].id);throw Error('BINDING '+role);}return one(d,role);}
        var doi=bound('doi');doi.contents=c.doiContract.text;
        var body=bound('body'),labels=0;
        for(var pi=0;pi<body.paragraphs.length;pi++)if(/^作者简介/.test(body.paragraphs[pi].contents)){
            var p=body.paragraphs[pi],end=String(p.contents).indexOf('：');if(end<0)end=String(p.contents).indexOf(':');
            if(end<0)throw Error('BIO_LABEL');applyBiographyLabelStyle(d,p.characters.itemByRange(0,end));labels++;
        }
        d.recompose();var footer=bound('footer').textContainers[0],lineY=receivedSeparatorY(footer.lines[0].baseline,c),items=d.allPageItems,guides=[],separators=[];
        for(var i=0;i<items.length;i++)if(items[i].parentPage&&items[i].parentPage.id===footer.parentPage.id){if(/^spacing-guide/.test(items[i].label))guides.push(items[i]);if(items[i].label==='article-footer-separator')separators.push(items[i]);}
        if(guides.length!==2||separators.length!==1)throw Error('RECEIVED_SEPARATOR_BINDING');
        guides.sort(function(a,b){return a.geometricBounds[0]-b.geometricBounds[0];});var b=guides[1].geometricBounds;guides[1].geometricBounds=[lineY-R.footerGap,b[1],lineY,b[3]];
        b=separators[0].geometricBounds;separators[0].geometricBounds=[lineY,b[1],lineY,b[3]];
        var first=body.textContainers[0],fb=first.geometricBounds;fb[2]=lineY-R.footerGap-R.footerGuideOffset+R.metadataFrameInset;first.geometricBounds=fb;d.recompose();
        return {doiText:c.doiContract.text,biographyLabels:labels,separatorY:lineY,receivedSeparatorBaselineGapMm:c.receivedSeparatorBaselineGapMm};
    }
    function fixedFrame(c,roleName){if(c.fixedFrames)for(var i=0;i<c.fixedFrames.length;i++)if(c.fixedFrames[i].role===roleName)return c.fixedFrames[i];throw Error('FIXED_FRAME_CONFIG '+roleName);}

    function restoreFixedFrame(frame,anchor){var b=frame.geometricBounds,height=b[2]-b[0];if(typeof anchor.left==='number')b[1]=anchor.left;if(typeof anchor.width==='number')b[3]=b[1]+anchor.width;if(typeof anchor.top==='number')b[0]=anchor.top;if(typeof anchor.bottom==='number'){b[2]=anchor.bottom;b[0]=b[2]-height;}frame.geometricBounds=b;}

    function localLeadingInterval(frame,index){var line=frame.lines[index];if(role(line.paragraphs[0],'body')==='bio')for(var ci=0;ci<line.characters.length;ci++)if(Number(line.characters[ci].pointSize)===12)return false;var current=line.insertionPoints[0].parentTextFrames,next=frame.lines[index+1].insertionPoints[0].parentTextFrames;return current.length&&next.length&&current[0].id===frame.id&&next[0].id===frame.id;}

    function lineExtent(frame){var count=0,start=-1,end=-1,tableLines=[],tables=frame.tables.everyItem().getElements();for(var i=0;i<frame.lines.length;i++){var line=frame.lines[i],owners=line.insertionPoints[0].parentTextFrames;if(owners.length&&owners[0].id===frame.id){if(start<0)start=line.insertionPoints[0].index;count++;end=Math.max(end,line.insertionPoints[-1].index);}}for(var ti=0;ti<tables.length;ti++)for(var ri=0;ri<tables[ti].rows.length;ri++)for(var ci=0;ci<tables[ti].rows[ri].cells.length;ci++){var lines=tables[ti].rows[ri].cells[ci].texts[0].lines;for(var li=0;li<lines.length;li++){var owners=lines[li].insertionPoints[0].parentTextFrames;if(owners.length&&owners[0].id===frame.id)tableLines.push(ti+':'+ri+':'+ci+':'+lines[li].insertionPoints[0].index+':'+lines[li].insertionPoints[-1].index);}}return {count:count,start:start,end:end,tableLines:tableLines.join('|')};}

    function sameExtent(a,b){return a.count===b.count&&a.start===b.start&&a.end===b.end&&a.tableLines===b.tableLines;}

    function leadingStep(d,body,frame,ranges,delta,target,measure){

        var extent=lineExtent(frame),error=Math.abs(target-measure(frame)),saved=[],factor=1;

        for(var i=0;i<ranges.length;i++){var styles=body.characters.itemByRange(ranges[i].start,ranges[i].end).textStyleRanges.everyItem().getElements();for(var j=0;j<styles.length;j++)saved.push({start:styles[j].characters[0].index,end:styles[j].characters[-1].index,lead:styles[j].leading});}

        for(var attempt=0;attempt<12;attempt++){

            var accepted=false;

            try{

                for(var i=0;i<ranges.length;i++){var r=ranges[i],min=typeof r.min==='number'?r.min:R.minLeading,max=typeof r.max==='number'?r.max:R.maxLeading;body.characters.itemByRange(r.start,r.end).leading=Math.max(min,Math.min(max,r.lead+delta*factor/ranges.length));}

