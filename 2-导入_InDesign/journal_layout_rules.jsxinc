        for(var i=1;i<fs.length;i++){var f=fs[i],b=f.geometricBounds;if(f.parentPage.documentOffset===d.pages.length-1||b[2]<264.9)continue;var target=b[2]-R.bottomInset;observations.push('BOTTOM '+f.parentPage.name+' '+i+' '+last(f)+' target '+target);if(Math.abs(last(f)-target)>R.tolerance)err('BOTTOM',f.parentPage.name+'/'+i+' '+last(f)+' target '+target);}

        if(fs.length>=2&&(!isFinite(last(fs[fs.length-1]))||!isFinite(last(fs[fs.length-2]))||Math.abs(last(fs[fs.length-1])-last(fs[fs.length-2]))>.01))err('LAST_PAGE_BALANCE','');

        for(var i=0;i<d.allGraphics.length;i++){var g=d.allGraphics[i],fr=g.parent,b=fr.geometricBounds;if(g.itemLink.status!==LinkStatus.NORMAL)err('LINK',g.itemLink.name);var isFigure=/figure-|图[1-9]/.test(g.itemLink.name);if(!isFigure)continue;var page=fr.parentPage,center=(b[1]+b[3])/2,left=page.side===PageSideOptions.LEFT_HAND?14.5:17.5,width=b[3]-b[1],expectedCenter=width>90?left+89:(center<left+89?left+42.75:left+135.25);if(c.figurePanels){var number=Number(fr.label.replace('source-figure-',''));for(var pi=0;pi<c.figurePanels.length;pi++){var panel=c.figurePanels[pi];for(var pn=0;pn<panel.numbers.length;pn++)if(panel.numbers[pn]===number){expectedCenter=figurePanelCenter(left,pn,panel.columns);if(page.documentOffset!==panel.pageIndex)err('FIGURE_PANEL_PAGE',g.itemLink.name);}}} if(Math.abs(center-expectedCenter)>.02)err('FIGURE_CENTER',g.itemLink.name+' '+center+' expected '+expectedCenter);}

        if(typeof JournalPrepreviewGate==='undefined')err('PREVIEW_GATE_MISSING','journal_prepreview_gate.jsxinc');else{var hardErrors=JournalPrepreviewGate.audit(d,c,{stories:stories,body:body,tables:tables,classify:role,visibleBottom:visibleBottom});for(var hardIndex=0;hardIndex<hardErrors.length;hardIndex++)errors.push(hardErrors[hardIndex]);}

        return {errors:errors,observations:observations,stories:stories,body:body,tables:tables};

    }

    function partitionPreflight(aggregated,pageNames,range){
        var rows=aggregated&&aggregated[2],r={scoped:[],outside:[],unknown:[]};if(!rows){r.unknown.push({reason:'PREFLIGHT_DETAILS_UNAVAILABLE'});return r;}
        for(var i=0;i<rows.length;i++){var row=rows[i];if(Number(row[0])!==3)continue;var issue={name:String(row[1]),page:String(row[2]),detail:String(row[3])};if(!range){r.scoped.push(issue);continue;}
            var offsets=[];for(var j=0;j<pageNames.length;j++)if(String(pageNames[j])===issue.page)offsets.push(j);
            if(offsets.length!==1)r.unknown.push(issue);else if(offsets[0]>=range[0]&&offsets[0]<=range[1])r.scoped.push(issue);else r.outside.push(issue);
        }return r;
    }
    function preflight(d){var profile=app.preflightProfiles.add({name:'Journal production '+new Date().getTime()}),proc=null;try{var a=['ADBE_MissingFonts','ADBE_MissingGlyph','ADBE_MissingModifiedGraphics','ADBE_OversetText'];for(var i=0;i<a.length;i++)profile.preflightProfileRules.add(a[i]).flag=PreflightRuleFlag.RETURN_AS_ERROR;proc=app.preflightProcesses.add(d,profile);proc.waitForProcess();return {summary:String(proc.processResults),aggregated:proc.aggregatedResults};}finally{if(proc)proc.remove();profile.remove();}}

    function xml(d,result,path){

        function x(t){return String(t).replace(/[\x00-\x08\x0B\x0C\x0E-\x1F]/g,'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/\r/g,'&#13;').replace(/\n/g,'&#10;').replace(/\t/g,'&#9;');}

        var out=['<audit document="'+x(d.name)+'" pages="'+d.pages.length+'">'];

        function para(p,i){var z=['<p index="'+i+'" style="'+x(p.appliedParagraphStyle.name)+'" text="'+x(p.contents)+'">'],rs=p.textStyleRanges.everyItem().getElements();for(var j=0;j<rs.length;j++){var r=rs[j];z.push('<r font="'+x(r.appliedFont.name)+'" face="'+x(r.fontStyle)+'" size="'+r.pointSize+'" leading="'+r.leading+'" position="'+r.position+'" status="'+r.appliedFont.status+'" cstyle="'+x(r.appliedCharacterStyle.name)+'">'+x(r.contents)+'</r>');}z.push('</p>');return z.join('');}

        for(var i=0;i<result.stories.length;i++){var s=result.stories[i];out.push('<story id="'+s.id+'" role="'+s.extractLabel('journal-role')+'" overflow="'+s.overflows+'">');for(var j=0;j<s.paragraphs.length;j++)out.push(para(s.paragraphs[j],j));out.push('</story>');}

        for(var i=0;i<result.tables.length;i++){var t=result.tables[i];out.push('<table rows="'+t.rows.length+'" columns="'+t.columns.length+'">');for(var j=0;j<t.rows.length;j++){out.push('<row>');for(var k=0;k<t.rows[j].cells.length;k++){var cell=t.rows[j].cells[k];out.push('<cell rowSpan="'+cell.rowSpan+'" columnSpan="'+cell.columnSpan+'" text="'+x(cell.contents)+'" overflow="'+cell.overflows+'">'+(cell.paragraphs.length?para(cell.paragraphs[0],0):'')+'</cell>');}out.push('</row>');}out.push('</table>');}

        for(var gi=0;gi<d.allGraphics.length;gi++){var g=d.allGraphics[gi],r=g.parent;var figureLabel=String(r.label).match(/^source-figure-([0-9]+)([a-z]?)$/);if(!figureLabel)continue;var b=r.geometricBounds,gb=g.geometricBounds,p=r.parentPage,scale=g.absoluteHorizontalScale,left=p.side===PageSideOptions.LEFT_HAND?14.5:17.5,position=b[3]-b[1]>90?'通栏':((b[1]+b[3])/2<left+89?'左栏':'右栏');out.push('<figure number="'+Number(figureLabel[1])+'" part="'+figureLabel[2]+'" name="'+x(g.itemLink.name)+'" path="'+x(g.itemLink.filePath)+'" page="'+x(p.name)+'" position="'+position+'" left="'+b[1]+'" top="'+b[0]+'" width="'+(b[3]-b[1])+'" height="'+(b[2]-b[0])+'" sourceWidth="'+((gb[3]-gb[1])*100/scale)+'" sourceHeight="'+((gb[2]-gb[0])*100/scale)+'" scaleX="'+scale+'" scaleY="'+g.absoluteVerticalScale+'"/>');}

        for(var i=0;i<result.errors.length;i++)out.push('<error code="'+x(result.errors[i].code)+'">'+x(result.errors[i].detail)+'</error>');for(var i=0;i<result.observations.length;i++)out.push('<observation>'+x(result.observations[i])+'</observation>');out.push('</audit>');var file=File(path);file.encoding='UTF-8';if(!file.open('w'))throw Error('AUDIT_WRITE');file.write(out.join('\n'));file.close();

    }

    function auditView(d,c){

        if(!c.articlePageRange)return d;

        var start=c.articlePageRange[0],end=c.articlePageRange[1];if(start<0||end>=d.pages.length||start>end)throw Error('ARTICLE_PAGE_RANGE');

        var pages=[],graphics=[],items=[],styles=[],stories=[],used={},storySeen={};for(var i=start;i<=end;i++)pages.push(d.pages[i]);

        for(var bi=0;bi<c.bindings.length;bi++){var bound=d.stories.itemByID(c.bindings[bi].id);if(bound.isValid&&!storySeen[bound.id]){stories.push(bound);storySeen[bound.id]=true;}}

        var documentItems=d.allPageItems;for(var i=0;i<documentItems.length;i++){var item=documentItems[i],p=item.parentPage;if(p&&p.documentOffset>=start&&p.documentOffset<=end)items.push(item);}

        var documentGraphics=d.allGraphics;for(var i=0;i<documentGraphics.length;i++){var g=documentGraphics[i],p=g.parent.parentPage;if(p&&p.documentOffset>=start&&p.documentOffset<=end)graphics.push(g);}

        for(var i=0;i<stories.length;i++)for(var j=0;j<stories[i].paragraphs.length;j++)used[stories[i].paragraphs[j].appliedParagraphStyle.id]=true;

        for(var i=0;i<d.allParagraphStyles.length;i++)if(used[d.allParagraphStyles[i].id])styles.push(d.allParagraphStyles[i]);

        return {name:d.name,pages:pages,spreads:[pages[0].parent],stories:stories,allGraphics:graphics,allPageItems:items,allParagraphStyles:styles,compositeFonts:d.compositeFonts,masterSpreads:d.masterSpreads,recompose:function(){d.recompose();}};

    }

    function run(d,c,apply){assertQA(d);if(apply)captionGapContract(c);if(apply&&c.articlePageRange)throw Error('FULL_TARGET_CHECK_ONLY');if(apply){var recovery=Folder(File(c.auditPath).parent.fsName+'/恢复副本');if(!recovery.exists&&!recovery.create())throw Error('RECOVERY_DIRECTORY');d.saveACopy(File(recovery.fsName+'/'+d.name.replace(/\.indd$/i,'')+'_'+new Date().getTime()+'.indd'));d.viewPreferences.rulerOrigin=RulerOrigin.PAGE_ORIGIN;d.zeroPoint=[0,0];}bind(d,c,apply);if(apply){applyTypography(d,c);geometry(d,c);fitFormulaNumbers(d);repairOrphans(d);if(c.bottomPlan){alignLocalBlocks(d,c);figureWhitespace(d,c,true);JournalBottomPlan.apply(d,c.bottomPlan);}else{alignLocalBlocks(d,c);repairOrphans(d);alignBottom(d);figureWhitespace(d,c,true);}}var view=auditView(d,c),result=audit(view,c);var pf=preflight(d);result.observations.push('PREFLIGHT '+pf.summary);if(String(pf.summary).split(String.fromCharCode(13)).join('').split(String.fromCharCode(10)).join('').replace(/ /g,'')!=='None'){var pageNames=[];for(var pfi=0;pfi<d.pages.length;pfi++)pageNames.push(d.pages[pfi].name);var issues=partitionPreflight(pf.aggregated,pageNames,c.articlePageRange);if(!issues.scoped.length&&!issues.outside.length&&!issues.unknown.length)issues.unknown.push({reason:'PREFLIGHT_DETAILS_EMPTY'});if(issues.scoped.length||issues.unknown.length)result.errors.push({code:'PREFLIGHT',detail:pf.summary});for(var pfi=0;pfi<issues.outside.length;pfi++)result.observations.push('PREFLIGHT_OUTSIDE_ARTICLE page='+issues.outside[pfi].page+' '+issues.outside[pfi].name);}xml(view,result,c.auditPath);return result;}

    return {captionGapContract:captionGapContract,inlineCaptionSpacing:inlineCaptionSpacing,bodyIndentation:bodyIndentation,sourceTableCharacterMatches:sourceTableCharacterMatches,specialGlyphRangeFontAllowed:specialGlyphRangeFontAllowed,balanceLastPage:balanceLastPage,lineChangeTrackingChoices:lineChangeTrackingChoices,fitFirstPageFrontTracking:fitFirstPageFrontTracking,receivedSeparatorY:receivedSeparatorY,applyBiographyLabelStyle:applyBiographyLabelStyle,repairTemplateDetails:repairTemplateDetails,formulaCacheIssues:formulaCacheIssues,repairBiographyHeadingLeading:repairBiographyHeadingLeading,normalizeDigitFonts:normalizeDigitFonts,prepareFinalPageReflow:prepareFinalPageReflow,applyEnglishAffiliationSpacing:applyEnglishAffiliationSpacing,orphanScope:orphanScope,bodyLeadingLimit:bodyLeadingLimit,bodyLeadingMinimum:bodyLeadingMinimum,formulaLineSpacing:formulaLineSpacing,formulaPadding:formulaPadding,removableHeadingBlank:removableHeadingBlank,separateCaptionSpacing:separateCaptionSpacing,formulaPlacementAllowed:formulaPlacementAllowed,normalizeTableCaption:normalizeTableCaption,normalizeStructuralSpacing:normalizeStructuralSpacing,sourceFormulaNumbering:sourceFormulaNumbering,sourceProjection:sourceProjection,sourceTextFormatting:sourceTextFormatting,forbiddenLineStart:forbiddenLineStart,graphicIsCropped:graphicIsCropped,partitionPreflight:partitionPreflight,run:run,audit:audit,continuedTableFragments:continuedTableFragments,syncContinuedTables:syncContinuedTables,continuedTableIssues:continuedTableIssues,sourceCaptionRange:sourceCaptionRange,xml:xml,bind:bind,rules:R,specialGlyphFont:specialGlyphFont,glyphFontIssue:glyphFontIssue,applySpecialGlyphs:applySpecialGlyphs,applyTypography:applyTypography,geometry:geometry,alignBottom:alignBottom,fitFormulaNumbers:fitFormulaNumbers,repairOrphans:repairOrphans,orphanLine:orphanLine,inkBounds:inkBounds,applySourceTableFormatting:applySourceTableFormatting,protectedTokens:protectedTokens,protectLineTokens:protectLineTokens,last:last,visibleBottom:visibleBottom,alignLocalBlocks:alignLocalBlocks,figureWhitespace:figureWhitespace,figurePanelCenter:figurePanelCenter,masterTextIssues:masterTextIssues,applyBottomPlan:function(d,p){return JournalBottomPlan.apply(d,p);}};

})();
