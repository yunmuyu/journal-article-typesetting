                accepted=sameExtent(after,extent)&&isFinite(current)&&Math.abs(target-current)<error-.0000001;

                if(accepted)return true;

            }finally{if(!accepted){for(var i=0;i<saved.length;i++)body.characters.itemByRange(saved[i].start,saved[i].end).leading=saved[i].lead;d.recompose();}}

            factor/=2;

        }

        return false;

    }

    function tableHeightStep(d,frame,rows,target,measure){

        measure=measure||last;var extent=lineExtent(frame),before=measure(frame),saved=[],factor=1;

        for(var i=0;i<rows.length;i++)saved.push(Number(rows[i].minimumHeight));

        for(var attempt=0;attempt<12;attempt++){

            var accepted=false;

            try{

                for(var i=0;i<rows.length;i++)rows[i].minimumHeight=Math.max(4.8,Math.min(5.5,saved[i]+(target-before)*factor/rows.length));

                d.recompose();var after=measure(frame);

                accepted=sameExtent(lineExtent(frame),extent)&&isFinite(after)&&Math.abs(target-after)<Math.abs(target-before)-.0000001;

                if(accepted)return true;

            }finally{if(!accepted){for(var i=0;i<rows.length;i++)rows[i].minimumHeight=saved[i];d.recompose();}}

