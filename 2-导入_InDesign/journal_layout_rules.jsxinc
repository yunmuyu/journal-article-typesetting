            var entry=expected[i],master=d.masterSpreads.itemByName(entry.masterName),matches=[];

            if(!master.isValid||master.pages.length<=entry.pageIndex){errors.push("missing master "+entry.masterName);continue;}

            var frames=master.pages[entry.pageIndex].allPageItems;

