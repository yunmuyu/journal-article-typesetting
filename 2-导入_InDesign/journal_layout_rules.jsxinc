    }

    function fitFirstColumnInk(d,body,frame,target,c){for(var pass=0;pass<12;pass++){var current=inkBounds(frame.lines[-1])[2],delta=(target-current)*72/25.4;if(Math.abs(delta)<.01)break;var ranges=[];for(var i=0;i+1<frame.lines.length;i++){if(!localLeadingInterval(frame,i))continue;var line=frame.lines[i],p=line.paragraphs[0];var localRole=role(p,'body');if((localRole!=='body'&&localRole!=='h1'&&localRole!=='h2')||p.tables.length)continue;var lead=Number(line.characters[-1].leading),minimum=bodyLeadingMinimum(line,c);if(delta>0&&lead>=16-.0001||delta<0&&lead<=minimum+.0001)continue;ranges.push({start:line.insertionPoints[0].index,end:line.insertionPoints[-1].index-1,lead:lead,min:minimum,max:16});}if(!ranges.length||!leadingStep(d,body,frame,ranges,delta,target,function(f){return inkBounds(f.lines[-1])[2];}))break;}return Math.abs(inkBounds(frame.lines[-1])[2]-target);}

    function lineChangeTrackingChoices(sample,current,count){
        var choices=[];
        for(var direction=-1;direction<=1;direction+=2){
            var maximum=direction>0?20-current:current+20;if(maximum<=0)continue;
            var end=sample(current+direction*maximum);if(end.lineCount===count)continue;
            var lo=0,hi=maximum;for(var pass=0;pass<12;pass++){var mid=(lo+hi)/2;if(sample(current+direction*mid).lineCount===count)lo=mid;else hi=mid;}
            for(var delta=hi+.002;delta<=maximum+.00001;delta+=.125){var tracking=Math.max(-20,Math.min(20,current+direction*delta)),state=sample(tracking),change=state.lineCount-count;if(Math.abs(change)>1)break;if(Math.abs(change)===1&&state.legal){choices.push({tracking:tracking,lineDelta:change});break;}}
        }
        choices.sort(function(a,b){return Math.abs(a.tracking-current)-Math.abs(b.tracking-current);});return choices;
    }
    function fitFirstPageFrontTracking(d,c){
        var front=one(d,'front'),body=one(d,'body'),p=null;
        for(var i=0;i<front.paragraphs.length;i++)if(/^Abstract\s*[:：]/.test(String(front.paragraphs[i].contents))){if(p)return false;p=front.paragraphs[i];}
        if(!p||p.lines.length<2){d.insertLabel('journal-first-page-front-tracking-diagnostics','NO_MULTILINE_ABSTRACT');return false;}
        var current=Number(p.characters[0].tracking),rs=p.textStyleRanges.everyItem().getElements();
        if(Math.abs(current)>20)return false;for(i=0;i<rs.length;i++)if(Number(rs[i].tracking)!==current)return false;
        var saved=[],frames=[],items=d.allPageItems,before=String(body.contents),ranges=body.textStyleRanges.everyItem().getElements();
        for(i=0;i<ranges.length;i++)saved.push({start:ranges[i].characters[0].index,end:ranges[i].characters[-1].index,leading:ranges[i].leading});
        var stories=[front,body,one(d,'footer')];for(i=0;i<stories.length;i++)for(var j=0;j<stories[i].textContainers.length;j++)frames.push({item:stories[i].textContainers[j],bounds:stories[i].textContainers[j].geometricBounds});
        for(i=0;i<items.length;i++)if(/^spacing-guide/.test(items[i].label)||items[i].label==='article-footer-separator')frames.push({item:items[i],bounds:items[i].geometricBounds});
        var count=p.lines.length,frame=front.textContainers[0];
        function restore(){p.tracking=current;for(var i=0;i<saved.length;i++)body.characters.itemByRange(saved[i].start,saved[i].end).leading=saved[i].leading;for(var i=0;i<frames.length;i++)frames[i].item.geometricBounds=frames[i].bounds;d.recompose();}
        function sample(value){p.tracking=value;frame.fit(FitOptions.FRAME_TO_CONTENT);d.recompose();var legal=p.lines[-1].words.length>=2,tokens=protectedTokens(p);for(var li=1;li<p.lines.length;li++){var offset=p.lines[li].insertionPoints[0].index-p.index;for(var ti=0;ti<tokens.length;ti++)if(tokens[ti].start<offset&&tokens[ti].end>=offset)legal=false;}return {lineCount:p.lines.length,legal:legal};}
        var accepted=false;
        try{
            var choices=lineChangeTrackingChoices(sample,current,count),diagnostics=['lines='+count,'choices='+choices.length];restore();d.insertLabel('journal-first-page-front-tracking-diagnostics',diagnostics.join(';'));
            for(var ci=0;ci<choices.length;ci++){
                var choice=choices[ci];p.tracking=choice.tracking;d.recompose();geometry(d,c,true);
                if(body.overflows)prepareFinalPageReflow(d);
                var footer=one(d,'footer'),target=receivedSeparatorY(footer.lines[0].baseline,c)-R.footerGap-R.footerGuideOffset;
                diagnostics.push('tracking='+choice.tracking+',delta='+choice.lineDelta+',bodyLines='+body.textContainers[0].lines.length+',inkDelta='+(visibleBottom(body.textContainers[0])-target)+',overflow='+body.overflows);d.insertLabel('journal-first-page-front-tracking-diagnostics',diagnostics.join(';'));
                if(!body.overflows&&Math.abs(visibleBottom(body.textContainers[0])-target)<.02&&String(body.contents)===before){accepted=true;d.insertLabel('journal-first-page-front-tracking',p.index+':'+choice.tracking+':'+choice.lineDelta);return true;}
                restore();
            }
            return false;
        }finally{if(!accepted)restore();}
    }

    function geometry(d,c,skipFrontTracking){

        var stories=scope(d),moves=[],seen={};

        function capture(it){while(it.parent&&it.parent.constructor.name==='Group')it=it.parent;if(seen[it.id]||!it.parentPage)return;seen[it.id]=true;var p=it.parentPage;moves.push({item:it,b:it.geometricBounds,page:p,oldLeft:p.side===PageSideOptions.LEFT_HAND?14.5:17.5});}

        for(var i=0;i<stories.length;i++){var fs=stories[i].textContainers;for(var j=0;j<fs.length;j++)capture(fs[j]);}

        var items=d.allPageItems;for(var i=0;i<items.length;i++)if(/^spacing-guide/.test(items[i].label)||items[i].label==='article-footer-separator')capture(items[i]);

        if(c.startOnLeft!==false&&d.pages[0].side!==PageSideOptions.LEFT_HAND){var section=d.sections[0];section.continueNumbering=false;section.pageNumberStart=Number(section.pageNumberStart)+1;d.documentPreferences.allowPageShuffle=true;}

        d.recompose();

        for(var i=0;i<moves.length;i++){var m=moves[i],left=m.page.side===PageSideOptions.LEFT_HAND?14.5:17.5,dx=left-m.oldLeft;if(dx){var b=m.b;m.item.geometricBounds=[b[0],b[1]+dx,b[2],b[3]+dx];}}

        var front=one(d,'front').textContainers[0];restoreFixedFrame(front,fixedFrame(c,'front'));front.fit(FitOptions.FRAME_TO_CONTENT);

        // In an issue continuation the article does not start at page 0, so all page
        // assumptions anchor on the article's own first page.
        var body=one(d,'body'),fs=body.textContainers,top=front.geometricBounds[2],firstPage=front.parentPage;

        for(var vf=0;vf<fs.length;vf++){fs[vf].textFramePreferences.verticalJustification=VerticalJustification.TOP_ALIGN;fs[vf].textFramePreferences.insetSpacing=[0,0,0,0];fs[vf].textFramePreferences.minimumFirstBaselineOffset=0;fs[vf].textFramePreferences.firstBaselineOffset=FirstBaseline.ASCENT_OFFSET;}d.recompose();

        var guides=[];items=d.allPageItems;for(var i=0;i<items.length;i++)if(/^spacing-guide/.test(items[i].label)&&items[i].parentPage===firstPage)guides.push(items[i]);

        if(guides.length!==2)throw Error('SPACING_GUIDE_BINDING');guides.sort(function(a,b){return a.geometricBounds[0]-b.geometricBounds[0];});

        var frontInk=inkBounds(front.lines[-1]),frontBounds=front.geometricBounds;if(frontBounds[2]<frontInk[2]){frontBounds[2]=frontInk[2];front.geometricBounds=frontBounds;}

        var targetInkTop=frontInk[2]+R.topGap,b=guides[0].geometricBounds;guides[0].geometricBounds=[frontInk[2],b[1],targetInkTop,b[3]];guides[0].nonprinting=true;guides[1].nonprinting=true;

        for(var i=0;i<2;i++){var firstInk=inkBounds(fs[i].lines[0]),b=fs[i].geometricBounds;b[0]+=targetInkTop-firstInk[0];fs[i].geometricBounds=b;}d.recompose();

        var footer=one(d,'footer').textContainers[0];footer.fit(FitOptions.FRAME_TO_CONTENT);restoreFixedFrame(footer,fixedFrame(c,'footer'));d.recompose();

        var footerInk=inkBounds(footer.lines[0]),fixedSeparatorY=receivedSeparatorY(footer.lines[0].baseline,c),targetBodyInk=fixedSeparatorY-R.footerGap-R.footerGuideOffset,b=fs[0].geometricBounds;b[2]=targetBodyInk+R.metadataFrameInset;fs[0].geometricBounds=b;d.recompose();fitFirstColumnInk(d,body,fs[0],targetBodyInk,c);
        for(var frontPass=0;frontPass<3;frontPass++){var topDrift=targetInkTop-inkBounds(fs[0].lines[0])[0];if(Math.abs(topDrift)<.005)break;var firstBounds=fs[0].geometricBounds;firstBounds[0]+=topDrift;fs[0].geometricBounds=firstBounds;d.recompose();fitFirstColumnInk(d,body,fs[0],targetBodyInk,c);}

        var rightInk=inkBounds(fs[1].lines[0]),rb=fs[1].geometricBounds;rb[0]+=targetInkTop-rightInk[0];fs[1].geometricBounds=rb;d.recompose();var b=guides[1].geometricBounds;guides[1].geometricBounds=[fixedSeparatorY-R.footerGap,b[1],fixedSeparatorY,b[3]];var lowerEdge=guides[1].geometricBounds[2];for(var si=0;si<items.length;si++)if(items[si].label==='article-footer-separator'){var sb=items[si].geometricBounds;items[si].geometricBounds=[lowerEdge,sb[1],lowerEdge,sb[3]];}

        for(var k=0;k<stories.length;k++){if(stories[k].extractLabel('journal-role')!=='body')continue;for(var i=1;i<stories[k].paragraphs.length;i++){

            var p=stories[k].paragraphs[i];if(!/^图\d+\s/.test(String(p.contents)))continue;

            var gap=stories[k].paragraphs[i-1];if(meaningful(gap.contents))throw Error('FIGURE_GAP_STRUCTURE');gap.leading=5;gap.pointSize=9;gap.spaceBefore=0;gap.spaceAfter=0;

            p.justification=Justification.CENTER_ALIGN;p.firstLineIndent=0;p.spaceBefore=0;p.spaceAfter=0;

        }}

        items=d.allPageItems;for(var i=0;i<items.length;i++)if(/^source-figure-/.test(items[i].label)||items[i].allGraphics.length&&items[i].parent&&items[i].parent.constructor.name==='Character'){

            var it=items[i];if(it.allGraphics.length!==1)continue;

            if(it.parent.constructor.name==='Character'){if(it.anchoredObjectSettings.horizontalAlignment!==HorizontalAlignment.CENTER_ALIGN)it.anchoredObjectSettings.horizontalAlignment=HorizontalAlignment.CENTER_ALIGN;if(it.fillColor.name!=='None')it.fillColor=d.swatches.itemByName('None');if(Number(it.strokeWeight)!==0)it.strokeWeight=0;}

        }

        if(!skipFrontTracking&&Math.abs(visibleBottom(fs[0])-targetBodyInk)>.02)fitFirstPageFrontTracking(d,c);
        d.recompose();

    }

    function last(f){var bottom=-Infinity;for(var li=0;li<f.lines.length;li++){var line=f.lines[li],frames=line.insertionPoints[0].parentTextFrames;if(frames.length&&frames[0].id===f.id)bottom=Math.max(bottom,Number(line.baseline));}var tables=f.tables.everyItem().getElements();for(var ti=0;ti<tables.length;ti++)for(var ri=0;ri<tables[ti].rows.length;ri++){var row=tables[ti].rows[ri];for(var ci=row.cells.length-1;ci>=0;ci--){var cell=row.cells[ci],ls=cell.texts[0].lines;if(cell.rowSpan!==1||!ls.length||cell.verticalJustification!==VerticalJustification.CENTER_ALIGN)continue;var first=ls[0],end=ls[-1],frames=first.insertionPoints[0].parentTextFrames;if(frames.length&&frames[0].id===f.id){var edge=(row.height+first.baseline+end.baseline-first.ascent+end.descent)/2;bottom=Math.max(bottom,edge-R.bottomInset);}break;}}var nativeObjects=f.allPageItems||[];for(var nfi=0;nfi<nativeObjects.length;nfi++){var nativeObject=nativeObjects[nfi],nativeDisplay=nativeObject.extractLabel('formula-display');if(!/^source-formula-/.test(nativeObject.label)||(nativeDisplay!=='true'&&nativeDisplay!=='unnumbered')||nativeObject.parent.constructor.name!=='Character')continue;var nativeOwners=nativeObject.parent.parentTextFrames;if(nativeOwners.length&&nativeOwners[0].id===f.id)bottom=Math.max(bottom,nativeObject.geometricBounds[2]-R.bottomInset);}return bottom===-Infinity?NaN:bottom;}

    function visibleBottom(f){var bottom=-Infinity;for(var li=f.lines.length-1;li>=0;li--){var line=f.lines[li],frames=line.insertionPoints[0].parentTextFrames;if(frames.length&&frames[0].id===f.id&&meaningful(line.contents)){bottom=inkBounds(line)[2];break;}}var tables=f.tables.everyItem().getElements();for(var ti=0;ti<tables.length;ti++)for(var ri=0;ri<tables[ti].rows.length;ri++){var row=tables[ti].rows[ri];for(var ci=row.cells.length-1;ci>=0;ci--){var cell=row.cells[ci],ls=cell.texts[0].lines;if(cell.rowSpan!==1||!ls.length||cell.verticalJustification!==VerticalJustification.CENTER_ALIGN)continue;var first=ls[0],end=ls[-1],frames=first.insertionPoints[0].parentTextFrames;if(frames.length&&frames[0].id===f.id)bottom=Math.max(bottom,(row.height+first.baseline+end.baseline-first.ascent+end.descent)/2);break;}}return bottom;}

    function repairBiographyHeadingLeading(d){
        var stories=scope(d),count=0;
        for(var si=0;si<stories.length;si++)for(var pi=0;pi<stories[si].paragraphs.length;pi++){
            var p=stories[si].paragraphs[pi];if(role(p,stories[si].extractLabel('journal-role'))!=='bio')continue;
            var text=String(p.contents),end=text.indexOf('：');if(end<0)end=text.indexOf(':');
            if(end>=0){p.characters.itemByRange(0,end).leading=16;count++;}
        }
        return count;
    }

    function alignLocalBlocks(d,c){
        repairBiographyHeadingLeading(d);

        var body=one(d,'body'),fs=body.textContainers,pairs=(c.localBottomPairs||[]).slice(0);

        if(fs.length>=2)pairs.push({frames:[fs.length-2,fs.length-1],finalPage:true});

        for(var fti=1;fti<fs.length;fti++)if(fs[fti].geometricBounds[2]>=264.9&&fs[fti].parentPage.id!==d.pages[-1].id)pairs.push({frames:[fti],fixedTarget:fs[fti].geometricBounds[2]-R.bottomInset});

