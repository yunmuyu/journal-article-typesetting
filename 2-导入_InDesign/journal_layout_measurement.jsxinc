/* Real composed lines, not character-count height estimates. */
var JournalLayoutMeasurement=(function(){
    function owner(line){var fs=line.insertionPoints[0].parentTextFrames;return fs.length?fs[0].id:null;}
    function role(p){
        var n=String(p.appliedParagraphStyle.name),s=String(p.contents);
        if(/^作者简介/.test(s))return "bio";
        if(n==="正文"||n==="正文_wrd_1"||n.indexOf("期刊正文_")===0)return "body";
        if(n==="一级标题")return "h1";
        if(n==="二级标题")return "h2";
        if(n==="参考文献 内容")return "reference";
        if(n==="参考文献 标题")return "referenceTitle";
        if(n==="公式")return "formula";
        if(n==="图注/表名")return "caption";
        return "other";
    }
    function adjustableLeading(l){
        if(role(l.paragraphs[0])!=="bio")return true;
        for(var i=0;i<l.characters.length;i++)if(Number(l.characters[i].pointSize)===12)return false;
        return true;
    }
    function lineRecord(l){
        var p=l.paragraphs[0];
        var owners=l.insertionPoints[0].parentTextFrames,ids=[];
        for(var i=0;i<owners.length;i++)ids.push(owners[i].id);
        var baseline,ascent,descent;
        try{baseline=Number(l.baseline);ascent=Number(l.ascent);descent=Number(l.descent);}
        catch(metricError){throw Error('LINE_METRIC_UNAVAILABLE '+l.insertionPoints[0].index+' text='+String(l.contents)+' '+metricError);}
        return {text:String(l.contents),start:l.insertionPoints[0].index,end:l.insertionPoints[-1].index,
            baseline:baseline,ascent:ascent,descent:descent,
            horizontalOffset:Number(l.horizontalOffset),endHorizontalOffset:Number(l.endHorizontalOffset),frameIds:ids,
            leading:Number(l.characters[-1].leading),adjustableLeading:adjustableLeading(l),role:role(p),style:String(p.appliedParagraphStyle.name),
            paragraphStart:p.insertionPoints[0].index,frameId:owner(l),hasTable:p.tables.length>0};
    }
    function trackingContext(p){
        var rs=p.textStyleRanges.everyItem().getElements(),out=[String(p.contents)],i;
        var names=["tracking","leading","pointSize","fontStyle","position","baselineShift","horizontalScale","verticalScale","noBreak"];
        for(i=0;i<rs.length;i++){
            var r=rs[i],a=[r.characters[0].index,r.characters[-1].index,String(r.appliedFont.name)];
            for(var j=0;j<names.length;j++)a.push(String(r[names[j]]));
            out.push(a.join(":"));
        }
        out.push([p.justification,p.firstLineIndent,p.leftIndent,p.rightIndent,p.spaceBefore,p.spaceAfter,
            p.keepWithNext,p.keepAllLinesTogether,p.startParagraph].join(":"));
        return out.join("|");
    }
    function flowSignature(body){
        var out=[String(body.contents)],fs=body.textContainers,i,j;
        for(i=0;i<fs.length;i++){
            var f=fs[i],gb=f.geometricBounds,bkey=[];for(var gi=0;gi<gb.length;gi++)bkey.push(Number(gb[gi]).toFixed(5));var a=[f.id,bkey.join(",")];
            for(j=0;j<f.lines.length;j++){
                var l=f.lines[j];if(owner(l)!==f.id)continue;
                a.push([l.insertionPoints[0].index,l.insertionPoints[-1].index,Number(l.baseline).toFixed(5),Number(l.characters[-1].leading)].join(":"));
            }
            out.push(a.join("/"));
        }
        return out.join("|");
    }
    function frameState(body){
        var fs=body.textContainers,out=[],i,j;
        for(i=0;i<fs.length;i++){
            var f=fs[i],ls=[],up=0,down=0;
            for(j=0;j<f.lines.length;j++)if(owner(f.lines[j])===f.id)ls.push(f.lines[j]);
            for(j=0;j+1<ls.length;j++){
                var p=ls[j].paragraphs[0],r=role(p),v=Number(ls[j].characters[-1].leading);
                var min=(r==="reference"||r==="bio")?12.6:14.8,max=(r==="reference"||r==="bio")?13.4:16;
                if(adjustableLeading(ls[j])&&!p.tables.length&&(r==="body"||r==="h1"||r==="h2"||r==="reference"||r==="bio")&&v>=min&&v<=max){down+=v-min;up+=max-v;}
            }
            out.push({id:f.id,endpoint:ls.length?[ls[0].insertionPoints[0].index,ls[ls.length-1].insertionPoints[-1].index]:null,
                lineCount:ls.length,bottomMm:JournalLayout.last(f),inkBottomMm:ls.length?JournalLayout.visibleBottom(f):null,
                leadingDownMm:down*25.4/72,leadingUpMm:up*25.4/72});
        }
        return out;
    }
    function capture(d,config){
        var body=null,i,j,k;
        for(i=0;i<d.stories.length;i++)if(d.stories[i].extractLabel("journal-role")==="body"){
            if(body)throw Error("MEASUREMENT_BODY_COUNT");body=d.stories[i];
        }
        if(!body)throw Error("MEASUREMENT_BODY_MISSING");
        var result={schemaVersion:1,documentId:d.id,documentPath:String(d.fullName.fsName),overflows:body.overflows,flowSignature:flowSignature(body),
            storyId:body.id,frames:[],paragraphs:[],tables:[],figures:[]};
        var frames=body.textContainers;
        for(i=0;i<frames.length;i++){
            var f=frames[i],lines=[];
            for(j=0;j<f.lines.length;j++)if(owner(f.lines[j])===f.id)lines.push(lineRecord(f.lines[j]));
            var bottom=JournalLayout.last(f),ink=lines.length?JournalLayout.visibleBottom(f):null;
            result.frames.push({index:i,id:f.id,pageIndex:f.parentPage.documentOffset,pageName:String(f.parentPage.name),
                bounds:f.geometricBounds,lines:lines,bottomMm:bottom,inkBottomMm:ink,
                targetBottomMm:f.geometricBounds[2]-JournalLayout.rules.bottomInset,
                endpoint:lines.length?[lines[0].start,lines[lines.length-1].end]:null});
        }
        if(config&&typeof config.receivedSeparatorBaselineGapMm==='number'){
            var footer=null;for(i=0;i<d.stories.length;i++)if(d.stories[i].extractLabel('journal-role')==='footer')footer=d.stories[i];
            if(!footer||!footer.lines.length)throw Error('MEASUREMENT_RECEIPT_MISSING');
            var targetInk=JournalLayout.receivedSeparatorY(footer.lines[0].baseline,config)-JournalLayout.rules.footerGap-JournalLayout.rules.footerGuideOffset;
            result.frames[0].targetInkBottomMm=targetInk;
            result.frames[0].targetBottomMm=targetInk-(result.frames[0].inkBottomMm-result.frames[0].bottomMm);
        }
        for(i=0;i<body.paragraphs.length;i++){
            var p=body.paragraphs[i];
            result.paragraphs.push({index:i,start:p.insertionPoints[0].index,end:p.insertionPoints[-1].index,
                text:String(p.contents),role:role(p),startParagraph:Number(p.startParagraph),
                keepWithNext:p.keepWithNext,keepAllLinesTogether:p.keepAllLinesTogether,
                spaceBefore:Number(p.spaceBefore),spaceAfter:Number(p.spaceAfter),
                firstFrameId:p.lines.length?owner(p.lines[0]):null,lastFrameId:p.lines.length?owner(p.lines[-1]):null});
        }
        for(i=0;i<body.tables.length;i++){
            var t=body.tables[i],rows=[],cells=[];
            for(j=0;j<t.rows.length;j++)rows.push({index:j,height:Number(t.rows[j].height),minimumHeight:Number(t.rows[j].minimumHeight)});
            for(j=0;j<t.cells.length;j++){
                var cell=t.cells[j],ls=[];
                for(k=0;k<cell.texts[0].lines.length;k++)ls.push(lineRecord(cell.texts[0].lines[k]));
                cells.push({index:j,text:String(cell.contents),rowIndex:cell.parentRow.index,columnIndex:cell.parentColumn.index,
                    rowSpan:cell.rowSpan,columnSpan:cell.columnSpan,width:Number(cell.width),height:Number(cell.height),
                    overflows:cell.overflows,lines:ls});
            }
            result.tables.push({index:i,id:t.id,label:String(t.label),headerRowCount:t.headerRowCount,
                skipFirstHeader:t.skipFirstHeader,rows:rows,cells:cells});
        }
        var items=d.allPageItems;
        for(i=0;i<items.length;i++)if(/^source-figure-/.test(items[i].label)){
            var it=items[i],tf=null;
            if(it.parent.constructor.name==="Character"&&it.parent.parentTextFrames.length)tf=it.parent.parentTextFrames[0];
            result.figures.push({id:it.id,label:it.label,bounds:it.geometricBounds,pageIndex:it.parentPage?it.parentPage.documentOffset:null,
                frameId:tf?tf.id:null,frameBounds:tf?tf.geometricBounds:null});
        }
        result.localBottomPairs=config.localBottomPairs||[];
        return result;
    }
    function probeTracking(d,requests){
        var body=null,i,j;
        for(i=0;i<d.stories.length;i++)if(d.stories[i].extractLabel("journal-role")==="body")body=d.stories[i];
        if(!body)throw Error("TRACKING_BODY_MISSING");
        var before=flowSignature(body),candidates=[],saved=[],out=[],seen={},savedFrames=[],primaryError=null;
        for(i=0;i<body.textContainers.length;i++)savedFrames.push({frame:body.textContainers[i],bounds:body.textContainers[i].geometricBounds.slice(0)});
        function flowState(){
            var state={length:String(body.contents).length,overflows:body.overflows,frames:[]};
            for(var fi=0;fi<body.textContainers.length;fi++){
                var frame=body.textContainers[fi],bounds=frame.geometricBounds,bkey=[],lines=[];
                for(var bi=0;bi<bounds.length;bi++)bkey.push(Number(bounds[bi]).toFixed(5));
                for(var li=0;li<frame.lines.length;li++){var line=frame.lines[li];if(owner(line)!==frame.id)continue;lines.push([line.insertionPoints[0].index,line.insertionPoints[-1].index,Number(line.baseline).toFixed(5),Number(line.characters[-1].leading)].join(":"));}
                state.frames.push({id:frame.id,bounds:bkey.join(","),lines:lines});
            }
            return state;
        }
        var originalFlow=flowState();
        function flowDifference(){
            var current=flowState(),diff=[];
            if(current.length!==originalFlow.length)diff.push("textLength "+originalFlow.length+"=>"+current.length);
            if(current.overflows!==originalFlow.overflows)diff.push("overflows "+originalFlow.overflows+"=>"+current.overflows);
            if(current.frames.length!==originalFlow.frames.length)diff.push("frameCount "+originalFlow.frames.length+"=>"+current.frames.length);
            for(var fi=0;fi<Math.min(current.frames.length,originalFlow.frames.length)&&diff.length<6;fi++){
                var a=originalFlow.frames[fi],b=current.frames[fi];
                if(a.id!==b.id)diff.push("frameId "+a.id+"=>"+b.id);
                if(a.bounds!==b.bounds)diff.push("bounds "+a.id+" "+a.bounds+"=>"+b.bounds);
                if(a.lines.length!==b.lines.length)diff.push("lineCount "+a.id+" "+a.lines.length+"=>"+b.lines.length);
                for(var li=0;li<Math.min(a.lines.length,b.lines.length)&&diff.length<6;li++)if(a.lines[li]!==b.lines[li]){diff.push("line "+a.id+"/"+li+" start:end:baseline:leading "+a.lines[li]+"=>"+b.lines[li]);break;}
            }
            return diff.join("; ")||"source or formatting context changed";
        }
        function restoreFrameBounds(){
            for(var fi=0;fi<savedFrames.length;fi++){
                var savedFrame=savedFrames[fi],bounds=savedFrame.frame.geometricBounds,changed=false;
                for(var bi=0;bi<4;bi++)if(Number(bounds[bi]).toFixed(5)!==Number(savedFrame.bounds[bi]).toFixed(5))changed=true;
                if(changed)savedFrame.frame.geometricBounds=savedFrame.bounds.slice(0);
            }
        }
        for(i=0;i<requests.length;i++){
            var q=requests[i],p=body.characters[q.start].paragraphs[0];
            if(p.insertionPoints[0].index!==q.start||String(p.contents)!==q.text||p.tables.length)throw Error("TRACKING_SOURCE_CHANGED "+q.start);
            if(seen[q.start])throw Error("TRACKING_DUPLICATE_SOURCE "+q.start);seen[q.start]=true;
            var rs=p.textStyleRanges.everyItem().getElements(),end=p.characters[-1].index,original=[];
            for(j=0;j<rs.length;j++){
                var range={start:Math.max(q.start,rs[j].characters[0].index),
                    end:Math.min(end,rs[j].characters[-1].index),value:Number(rs[j].tracking)};
                if(!isFinite(range.value)||Math.abs(range.value)>20)throw Error("TRACKING_BASE_RANGE "+q.start);
                saved.push(range);original.push(range);
            }
            var uniform=original[0].value;for(j=1;j<original.length;j++)if(original[j].value!==uniform)uniform=null;
            candidates.push(p);out.push({probeVersion:2,probeIndex:i,start:q.start,end:end,text:q.text,currentLines:p.lines.length,
                currentTracking:uniform,originalTracking:original,context:trackingContext(p),outcomes:[]});
        }
        function restore(ranges){
            for(var k=0;k<ranges.length;k++)if(ranges[k].end>=ranges[k].start)body.characters.itemByRange(ranges[k].start,ranges[k].end).tracking=ranges[k].value;
        }
        function restoreStable(ranges,record,phase){
            var diagnostics=[];
            for(var attempt=0;attempt<3;attempt++){
                restore(ranges);restoreFrameBounds();d.recompose();
                var contexts=true;
                if(record)contexts=trackingContext(candidates[record.probeIndex])===record.context;
                else for(var ci=0;ci<candidates.length;ci++)if(trackingContext(candidates[ci])!==out[ci].context){contexts=false;break;}
                if(flowSignature(body)===before&&body.overflows===originalFlow.overflows&&contexts){
                    if(record&&diagnostics.length)record.restoreDiagnostics=diagnostics;
                    return attempt+1;
                }
                diagnostics.push("attempt "+(attempt+1)+" "+flowDifference()+(contexts?"":"; trackingContext changed"));
            }
            throw Error("TRACKING_PROBE_RESTORE_CHANGED_FLOW "+phase+(record?" start="+record.start:"")+" "+diagnostics.join(" | "));
        }
        function observation(p,value,record){
            var orphan=false,breaks=[],tokens=JournalLayout.protectedTokens(p),start=p.insertionPoints[0].index;
            for(var k=0;k<p.lines.length;k++){
                if(JournalLayout.orphanLine(p.lines[k]))orphan=true;
                if(k>0){var at=p.lines[k].insertionPoints[0].index-start;
                    for(var t=0;t<tokens.length;t++)if(tokens[t].start<at&&tokens[t].end>=at)breaks.push(tokens[t].text);}
            }
            var resized=[],finalExpansion=false;
            try{
                if(body.overflows){
                    var fs=body.textContainers,maximum=0;for(var fi=0;fi<fs.length;fi++)maximum=Math.max(maximum,Number(fs[fi].geometricBounds[2]));
                    if(fs.length>=2&&fs[fs.length-2].parentPage.id===fs[fs.length-1].parentPage.id){
                        for(fi=fs.length-2;fi<fs.length;fi++){var b=fs[fi].geometricBounds;resized.push({frame:fs[fi],bounds:b});var expanded=[b[0],b[1],b[2],b[3]];expanded[2]=maximum;fs[fi].geometricBounds=expanded;}
                        d.recompose();finalExpansion=!body.overflows;
                    }
                }
                return {tracking:value,lineCount:p.lines.length,lineDelta:p.lines.length-record.baseLines,
                    currentLineDelta:p.lines.length-record.currentLines,orphanFree:!orphan,
                    tokenBreakFree:breaks.length===0,tokenBreaks:breaks,overflows:body.overflows,frames:frameState(body),finalPageExpansion:finalExpansion};
            }finally{for(var ri=0;ri<resized.length;ri++)resized[ri].frame.geometricBounds=resized[ri].bounds;if(resized.length)d.recompose();}
        }
        try{
            // Every paragraph is measured in isolation; other applied tracking remains in place.
            for(i=0;i<candidates.length;i++){
                var p=candidates[i],record=out[i];
                record.currentFrames=frameState(body);
                p.tracking=0;d.recompose();record.baseLines=p.lines.length;
                record.outcomes.push(observation(p,0,record));
                for(var direction=-1;direction<=1;direction+=2){
                    p.tracking=20*direction;d.recompose();
                    var edge=observation(p,20*direction,record);record.outcomes.push(edge);
                    if(edge.lineDelta*direction<1)continue;
                    var lo=0,hi=20;
                    for(var pass=0;pass<9;pass++){
                        var mid=(lo+hi)/2;p.tracking=mid*direction;d.recompose();
                        if((p.lines.length-record.baseLines)*direction>=1)hi=mid;else lo=mid;
                    }
                    p.tracking=hi*direction;d.recompose();
                    var refined=observation(p,hi*direction,record);refined.minimumWithin=.0390625;
                    record.outcomes.push(refined);
                    if((!refined.orphanFree||!refined.tokenBreakFree||refined.overflows)&&edge.orphanFree&&edge.tokenBreakFree&&!edge.overflows){
                        var previous=hi;
                        for(var sample=hi+.25;sample<=20.000001;sample=Math.min(20,sample+.25)){
                            p.tracking=sample*direction;d.recompose();
                            var usable=observation(p,sample*direction,record);
                            if(usable.lineDelta===direction&&usable.orphanFree&&usable.tokenBreakFree&&!usable.overflows){
                                var lowLegal=previous,highLegal=sample;
                                for(var legalPass=0;legalPass<4;legalPass++){
                                    var legalMid=(lowLegal+highLegal)/2;p.tracking=legalMid*direction;d.recompose();
                                    var candidate=observation(p,legalMid*direction,record);
                                    if(candidate.lineDelta===direction&&candidate.orphanFree&&candidate.tokenBreakFree&&!candidate.overflows)highLegal=legalMid;else lowLegal=legalMid;
                                }
                                p.tracking=highLegal*direction;d.recompose();usable=observation(p,highLegal*direction,record);usable.minimumLegalWithin=.015625;
                                record.outcomes.push(usable);break;
                            }
                            previous=sample;if(sample===20)break;
                        }
                    }
                }
                record.restoreAttempts=restoreStable(record.originalTracking,record,"paragraph");
                record.current=observation(p,record.currentTracking,record);
                if(trackingContext(p)!==record.context||flowSignature(body)!==before)record.restoreAttempts+=restoreStable(record.originalTracking,record,"current-observation");
            }
        }catch(error){primaryError=error;throw error;}
        finally{
            if(saved.length)try{restoreStable(saved,null,"final");}
            catch(restoreError){if(primaryError)throw Error(String(primaryError)+"; FINAL_RESTORE "+String(restoreError));throw restoreError;}
        }
        return out;
    }
    return {adjustableLeading:adjustableLeading,frameState:frameState,paragraphRole:role,capture:capture,lineRecord:lineRecord,probeTracking:probeTracking,trackingContext:trackingContext,flowSignature:flowSignature};
}());
